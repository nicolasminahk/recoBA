---
import '../styles/global.css';
import { EMAIL, DEMO_PORTAL } from '../data/site.js';
import { useT, getLang, homePath, LOCALES, DEFAULT_LOCALE } from '../i18n/index.js';
import es from '../i18n/es.js';
import en from '../i18n/en.js';

interface Props {
  title?: string;
  description?: string;
}

const t = useT(Astro);
const lang = getLang(Astro);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(t.meta.ogImage, Astro.site);
const home = new URL(homePath(lang), Astro.site);
const hreflang = { es: es.meta.htmlLang, en: en.meta.htmlLang };
const otherOgLocales = LOCALES.filter((l) => l !== lang).map((l) => ({ es, en })[l].meta.ogLocale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#org`,
      name: 'recoBA',
      url: String(Astro.site),
      logo: new URL('/favicon.svg', Astro.site).toString(),
      email: EMAIL,
      founder: { '@type': 'Person', name: 'Nicolás Minahk' },
      areaServed: ['Madrid', 'Valencia', 'Málaga', 'España'],
    },
    {
      '@type': 'SoftwareApplication',
      name: t.meta.appName,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: String(home),
      description,
      inLanguage: t.meta.htmlLang,
      provider: { '@id': `${Astro.site}#org` },
      screenshot: DEMO_PORTAL,
      offers: t.precios.paquetes.map((p) => ({
        '@type': 'Offer',
        name: p.nombre,
        price: p.precio.replace(/[.,]/g, ''),
        priceCurrency: 'EUR',
        url: `${home}#precios`,
      })),
    },
  ],
};
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={hreflang[l]} href={new URL(homePath(l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(homePath('es'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="preload"
      href="/fonts/ClashDisplay-Semibold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeneralSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {otherOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:site_name" content="recoBA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#F7F3EC" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      lang === DEFAULT_LOCALE && (
        <script is:inline define:vars={{ paths: Object.fromEntries(LOCALES.map((l) => [l, homePath(l)])) }}>
          // Quien ya eligió otro idioma con el selector y vuelve a la raíz (/) va a su versión.
          // Solo en la raíz: un enlace directo a /en/ siempre abre en inglés, y sin
          // elección guardada no se redirige (los buscadores ven cada idioma en su URL).
          try {
            var saved = localStorage.getItem('recoba-lang');
            if (saved && paths[saved] && paths[saved] !== location.pathname) location.replace(paths[saved] + location.hash);
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body class="grain bg-paper text-ink antialiased">
    <a href="#main" class="skip-link">{t.meta.skip}</a>
    <slot />
  </body>
</html>
