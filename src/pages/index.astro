---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Proceso from '../components/Proceso.astro';
import WhyBA from '../components/WhyBA.astro';
import Caso from '../components/Caso.astro';
import Estructura from '../components/Estructura.astro';
import Herramientas from '../components/Herramientas.astro';
import Riesgos from '../components/Riesgos.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Proceso />
    <WhyBA />
    <Caso />
    <Estructura />
    <Herramientas />
    <Riesgos />
    <Cta />
  </main>
  <Footer />
  <script>
    import '../scripts/main.js';
  </script>
