---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Propuesta from '../components/Propuesta.astro';
import Producto from '../components/Producto.astro';
import Propiedad from '../components/Propiedad.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import ParaQuien from '../components/ParaQuien.astro';
import Precios from '../components/Precios.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Problema />
    <Propuesta />
    <Producto />
    <Propiedad />
    <ComoFunciona />
    <ParaQuien />
    <Precios />
    <Faq />
    <Cta />
  </main>
  <Footer />
  <script>
    import '../scripts/main.js';
  </script>
</Base>
