---
const pasos = [
  {
    n: '01',
    titulo: 'Comprar bien',
    texto: 'A reciclar, sucesiones, urgencias: entramos 20–30% bajo mercado.',
    icon: 'buy',
  },
  {
    n: '02',
    titulo: 'Transformar',
    texto: 'Reforma integral llave en mano en 6–8 meses.',
    icon: 'build',
  },
  {
    n: '03',
    titulo: 'Capturar valor',
    texto: 'Renta temporal premium en USD y venta en ventana óptima.',
    icon: 'value',
  },
];
---

<section id="flipping" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 md:col-span-5">
        <p class="eyebrow text-copper" data-reveal>La estrategia</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
          ¿Qué es el <span class="u-copper">house flipping</span>?
        </h2>
      </div>
      <div class="col-span-12 mt-6 md:col-span-6 md:col-start-7 md:mt-2">
        <p class="text-lg text-ink/70" data-reveal>
          Comprar barato, transformar, vender caro. En Buenos Aires, hoy, las tres
          piezas se alinean.
        </p>
      </div>
    </div>

    <ol class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-ink/10 bg-ink/10 md:grid-cols-3">
      {
        pasos.map((p) => (
          <li class="group relative bg-paper p-8 md:p-10" data-step-card>
            <div class="flex items-start justify-between">
              <span class="display tnum text-[2.6rem] leading-none text-ink/15 transition-colors duration-300 group-hover:text-copper">
                {p.n}
              </span>
              {p.icon === 'buy' && (
                <svg class="a-draw h-16 w-16 text-ink" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M10 30 L32 12 L54 30" />
                  <path d="M16 28 V52 H48 V28" />
                  <path d="M27 52 V38 H37 V52" class="stroke-copper" />
                  <circle cx="46" cy="20" r="9" class="stroke-copper" />
                  <path d="M43 20 h6 M46 17 v6" class="stroke-copper" />
                </svg>
              )}
              {p.icon === 'build' && (
                <svg class="a-draw h-16 w-16 text-ink" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="12" y="12" width="40" height="40" />
                  <line x1="12" y1="32" x2="52" y2="32" />
                  <line x1="32" y1="12" x2="32" y2="32" />
                  <path d="M20 44 L30 38 M36 46 L46 40" class="stroke-copper" />
                  <circle cx="24" cy="24" r="4" class="stroke-copper" />
                </svg>
              )}
              {p.icon === 'value' && (
                <svg class="a-draw h-16 w-16 text-ink" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <polyline points="10,50 24,38 34,44 54,22" class="stroke-copper" />
                  <polyline points="44,22 54,22 54,32" class="stroke-copper" />
                  <line x1="10" y1="56" x2="54" y2="56" />
                  <line x1="14" y1="50" x2="14" y2="56" />
                  <line x1="28" y1="42" x2="28" y2="56" />
                  <line x1="42" y1="34" x2="42" y2="56" />
                </svg>
              )}
            </div>
            <h3 class="display mt-8 text-2xl">{p.titulo}</h3>
            <p class="mt-3 text-[0.98rem] leading-relaxed text-ink/70">{p.texto}</p>
          </li>
        ))
      }
    </ol>

    <!-- Callout flipping paciente -->
    <aside
      class="relative mt-10 overflow-hidden rounded-2xl border border-copper/30 bg-paper-2 p-8 md:p-12"
      data-reveal
    >
      <div class="grid grid-cols-12 items-center gap-6">
        <div class="col-span-12 lg:col-span-8">
          <p class="eyebrow text-copper">Por qué lo llamamos «flipping paciente»</p>
          <p class="mt-4 max-w-[46rem] text-lg leading-relaxed">
            Vender recién reformado se come el margen: la fricción de compra + venta
            ronda el <strong class="tnum">12%</strong>. Rentamos primero en dólares y
            vendemos cuando el ciclo acompaña.
          </p>
        </div>
        <div class="col-span-12 lg:col-span-4">
          <div class="flex items-end justify-start gap-8 lg:justify-end">
            <div>
              <p class="display tnum text-[3.2rem] leading-none text-copper">~12%</p>
              <p class="eyebrow mt-2 text-ink/50">fricción compra + venta</p>
            </div>
            <div>
              <p class="display tnum text-[3.2rem] leading-none">3–5</p>
              <p class="eyebrow mt-2 text-ink/50">años de renta en USD</p>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>
