---
import { mailtoDemo, RADAR } from '../data/site.js';
import { useT, getLang } from '../i18n/index.js';

const t = useT(Astro).precios;
const ctaDemo = useT(Astro).common.ctaDemo;
const MAILTO_DEMO = mailtoDemo(getLang(Astro));
const { paquetes, condiciones } = t;
---

<section id="precios" class="relative overflow-hidden bg-ink py-20 text-paper md:py-28">
  <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>
  <div class="blob right-[5%] bottom-[10%] h-[28rem] w-[28rem] bg-copper/18" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-6">
      <div class="col-span-12 lg:col-span-6">
        <p class="eyebrow text-copper" data-reveal>{t.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2rem,4.2vw,3.6rem)]" data-reveal>
          {t.title[0]}<br />{t.title[1]}
        </h2>
      </div>
      <div class="col-span-12 flex items-end lg:col-span-5 lg:col-start-8">
        <p class="text-lg text-paper/65" data-reveal>
          {t.lead}
        </p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {
        paquetes.map((p) => (
          <article
            class:list={[
              'glass-ink flex flex-col rounded-2xl p-7 md:p-8',
              p.recomendado && 'ring-1 ring-copper/70',
            ]}
            data-card
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="display text-2xl">{p.nombre}</h3>
              {p.recomendado && (
                <span class="eyebrow rounded-full border border-copper/60 px-3 py-1.5 text-copper">
                  {t.recomendado}
                </span>
              )}
            </div>
            <p class="mt-1.5 text-[0.9rem] text-paper/55">{p.para}</p>
            <p class="display tnum mt-6 text-[2.6rem] leading-none">
              {t.moneda.before && <span class="mr-0.5 text-[1.4rem]">{t.moneda.before}</span>}
              {p.precio}
              {t.moneda.after && <span class="ml-1 text-[1.4rem]">{t.moneda.after}</span>}
            </p>
            <p class="mt-1.5 text-[0.78rem] text-paper/45">{t.pagoUnico}</p>
            <ul class="mt-7 flex-1 space-y-2.5 border-t border-paper/12 pt-6">
              {p.items.map((i) => (
                <li class="flex items-start gap-3 text-[0.92rem] leading-relaxed text-paper/80">
                  <span class="mt-[0.6rem] h-1.5 w-1.5 shrink-0 rounded-full bg-copper" aria-hidden="true" />
                  {i}
                </li>
              ))}
            </ul>
            <a
              href={MAILTO_DEMO}
              class:list={['btn mt-8 justify-center', p.recomendado ? 'btn-copper' : 'btn-ghost-light']}
            >
              {ctaDemo} <span class="arr" aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <dl class="mt-8 grid grid-cols-1 gap-x-8 gap-y-4 border-t border-paper/15 pt-7 sm:grid-cols-2 lg:grid-cols-5" data-reveal>
      {
        condiciones.map(([k, v]) => (
          <div>
            <dt class="eyebrow text-paper/45">{k}</dt>
            <dd class="mt-1.5 text-[0.9rem] leading-relaxed text-paper/80">{v}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 flex flex-col gap-3 rounded-2xl border border-paper/15 px-6 py-5 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="text-[0.92rem] text-paper/75">
        <strong class="font-semibold text-paper">{t.extraLabel}</strong> {t.extra}
      </p>
      <a href={RADAR} target="_blank" rel="noopener" class="text-[0.9rem] font-medium text-copper hover:text-paper">
        {t.extraLink} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
