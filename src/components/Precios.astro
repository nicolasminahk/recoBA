---
import { MAILTO_DEMO, RADAR } from '../data/site.js';

const paquetes = [
  {
    nombre: 'Esencial',
    precio: '8.500',
    para: 'Para empezar a centralizar.',
    items: [
      'Panel de administración y portal del inversor',
      'Instalación en sus cuentas, con su marca y dominio',
      'Avances, documentos, personas y números de cada obra',
      'Bandeja de correo del panel',
      'Carga de hasta 3 obras y 2 formaciones',
      '60 días de garantía',
    ],
    recomendado: false,
  },
  {
    nombre: 'Profesional',
    precio: '12.500',
    para: 'Para toda la cartera.',
    items: [
      'Todo lo de Esencial',
      'Puesta en marcha con hasta 10 obras en curso',
      'Números de la obra actualizables desde Excel',
      'Cámara de la obra conectada a sus señales',
      'Fases, partidas y perfiles a su medida',
      '90 días de garantía',
    ],
    recomendado: true,
  },
  {
    nombre: 'Integral',
    precio: '14.900',
    para: 'Sin preocuparse de la parte técnica.',
    items: [
      'Todo lo de Profesional',
      '12 meses de mantenimiento incluidos',
      'Actualizaciones y copias verificadas',
      '2 horas al mes de soporte y mejoras',
    ],
    recomendado: false,
  },
];

const condiciones = [
  ['Mantenimiento opcional', '190 €/mes (2 h) · 390 €/mes (5 h)'],
  ['Diagnóstico', '1.500 €, se descuenta al contratar'],
  ['Horas adicionales', '75 €/h'],
  ['Pago', '40 % firma · 40 % instalación · 20 % entrega'],
  ['Infraestructura', 'A cargo de su empresa, aprox. 50–80 €/mes'],
];
---

<section id="precios" class="relative overflow-hidden bg-ink py-20 text-paper md:py-28">
  <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>
  <div class="blob right-[5%] bottom-[10%] h-[28rem] w-[28rem] bg-copper/18" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-6">
      <div class="col-span-12 lg:col-span-6">
        <p class="eyebrow text-copper" data-reveal>Precios</p>
        <h2 class="display mt-4 text-[clamp(2rem,4.2vw,3.6rem)]" data-reveal>
          Un pago único.<br />Sin cuotas obligatorias.
        </h2>
      </div>
      <div class="col-span-12 flex items-end lg:col-span-5 lg:col-start-8">
        <p class="text-lg text-paper/65" data-reveal>
          Precios sin IVA, orientativos. Se confirman tras el diagnóstico.
        </p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {
        paquetes.map((p) => (
          <article
            class:list={[
              'glass-ink flex flex-col rounded-2xl p-7 md:p-8',
              p.recomendado && 'ring-1 ring-copper/70',
            ]}
            data-card
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="display text-2xl">{p.nombre}</h3>
              {p.recomendado && (
                <span class="eyebrow rounded-full border border-copper/60 px-3 py-1.5 text-copper">
                  Recomendado
                </span>
              )}
            </div>
            <p class="mt-1.5 text-[0.9rem] text-paper/55">{p.para}</p>
            <p class="display tnum mt-6 text-[2.6rem] leading-none">
              {p.precio}<span class="ml-1 text-[1.4rem]">€</span>
            </p>
            <p class="mt-1.5 text-[0.78rem] text-paper/45">Pago único · sin IVA</p>
            <ul class="mt-7 flex-1 space-y-2.5 border-t border-paper/12 pt-6">
              {p.items.map((i) => (
                <li class="flex items-start gap-3 text-[0.92rem] leading-relaxed text-paper/80">
                  <span class="mt-[0.6rem] h-1.5 w-1.5 shrink-0 rounded-full bg-copper" aria-hidden="true" />
                  {i}
                </li>
              ))}
            </ul>
            <a
              href={MAILTO_DEMO}
              class:list={['btn mt-8 justify-center', p.recomendado ? 'btn-copper' : 'btn-ghost-light']}
            >
              Pedir una demo <span class="arr" aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <dl class="mt-8 grid grid-cols-1 gap-x-8 gap-y-4 border-t border-paper/15 pt-7 sm:grid-cols-2 lg:grid-cols-5" data-reveal>
      {
        condiciones.map(([k, v]) => (
          <div>
            <dt class="eyebrow text-paper/45">{k}</dt>
            <dd class="mt-1.5 text-[0.9rem] leading-relaxed text-paper/80">{v}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 flex flex-col gap-3 rounded-2xl border border-paper/15 px-6 py-5 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="text-[0.92rem] text-paper/75">
        <strong class="font-semibold text-paper">Servicio adicional:</strong> radar de
        oportunidades a medida, en propuesta aparte.
      </p>
      <a href={RADAR} target="_blank" rel="noopener" class="text-[0.9rem] font-medium text-copper hover:text-paper">
        Ver un ejemplo: buscador.recoba.casa <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
