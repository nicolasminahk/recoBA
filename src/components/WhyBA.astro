---
// Gráfico m² premium — escala sobre máx. 7.000 US$/m²
const ciudades = [
  { ciudad: 'Madrid', valor: '~US$ 7.000', w: 1 },
  { ciudad: 'Barcelona', valor: '~US$ 6.100', w: 0.871 },
  { ciudad: 'Montevideo', valor: 'US$ 3.209', w: 0.458 },
  { ciudad: 'Ciudad de México', valor: 'US$ 2.909', w: 0.416 },
  { ciudad: 'Buenos Aires', valor: '~US$ 2.600', w: 0.371, destacada: true },
];

const cards = [
  { dato: '69.461', label: 'escrituras CABA 2025 · +26,8%, mejor año en dos décadas' },
  { dato: '30–37%', label: 'brecha récord usado vs. a estrenar: el arbitraje' },
  { dato: '12–33%', label: 'bajo el pico de 2018 · +5,4% i.a. 2025' },
  {
    dato: '0%',
    label: 'reforma fiscal 2026: venta exenta del cedular',
    link: { href: '#riesgos', label: 'Es reversible → riesgos' },
  },
];
---

<section id="por-que-ahora" class="relative bg-ink py-24 text-paper md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 lg:col-span-5">
        <p class="eyebrow text-copper" data-reveal>El momento</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
          ¿Por qué Buenos Aires?<br />¿Por qué ahora?
        </h2>
        <p class="mt-6 max-w-[30rem] text-paper/65" data-reveal>
          El m² más barato de las grandes capitales, un mercado que volvió a
          transaccionar y una brecha récord entre usado y a estrenar.
        </p>
      </div>

      <!-- Gráfico de barras m² -->
      <div class="col-span-12 mt-12 lg:col-span-7 lg:mt-0">
        <figure
          data-chart-m2
          aria-label="Comparativa del precio del metro cuadrado premium: Madrid unos 7.000 dólares, Barcelona 6.100, Montevideo 3.209, Ciudad de México 2.909 y Buenos Aires unos 2.600 dólares — la más barata de las cinco ciudades."
        >
          <figcaption class="eyebrow mb-6 text-paper/50">
            m² premium · US$ — 2025/26
          </figcaption>
          <div class="overflow-x-auto">
            <svg viewBox="0 0 640 300" class="h-auto w-full min-w-[520px]" role="presentation">
            {
              ciudades.map((c, i) => {
                const y = i * 58;
                const barW = 440 * c.w;
                return (
                  <g>
                    <text
                      x="0"
                      y={y + 22}
                      class="fill-paper"
                      font-size="15"
                      font-weight={c.destacada ? '600' : '400'}
                      opacity={c.destacada ? '1' : '0.7'}
                    >
                      {c.ciudad}
                    </text>
                    <rect
                      x="0"
                      y={y + 30}
                      width={barW}
                      height="14"
                      rx="2"
                      class={c.destacada ? 'fill-copper' : 'fill-sage'}
                      opacity={c.destacada ? '1' : '0.75'}
                      data-bar
                      style="transform-box: fill-box; transform-origin: left center;"
                    />
                    <text
                      x={barW + 12}
                      y={y + 42}
                      class="fill-paper tnum"
                      font-size="14"
                      font-weight="600"
                      data-bar-label
                    >
                      {c.valor}
                    </text>
                  </g>
                );
              })
            }
            </svg>
          </div>
          <p class="mt-4 text-[0.78rem] text-paper/40">
            Fuentes: idealista (jun-2026) · RIAL UTDT (sep-2025)
          </p>
        </figure>
      </div>
    </div>

    <!-- Data cards -->
    <div class="mt-20 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-paper/12 bg-paper/12 sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((c) => (
          <article class="group flex flex-col bg-ink p-7" data-data-card>
            <p class="display tnum text-[2.6rem] leading-none text-copper">{c.dato}</p>
            <p class="eyebrow mt-3 leading-relaxed text-paper/60">{c.label}</p>
            {c.link && (
              <a
                href={c.link.href}
                class="mt-auto inline-block pt-3 text-[0.82rem] font-semibold text-copper hover:text-paper"
              >
                {c.link.label}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
