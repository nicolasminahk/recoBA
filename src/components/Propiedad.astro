---
import Shot from './Shot.astro';
import ajustes from '../assets/shots/admin-ajustes-instalacion.png';
import { useT } from '../i18n/index.js';

const t = useT(Astro).propiedad;
const { tarjetas } = t;
---

<section id="propiedad" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 lg:col-span-5">
        <p class="eyebrow text-copper" data-reveal>{t.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2rem,4.2vw,3.6rem)]" data-reveal>
          {t.title}
        </h2>
        <p class="mt-5 max-w-[34rem] text-lg text-ink/70" data-reveal>
          {t.lead}
        </p>
      </div>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7">
        <Shot
          src={ajustes}
          domain="gestion.recoba.casa/admin"
          alt={t.alt}
        />
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        tarjetas.map((t) => (
          <article class="glass rounded-2xl p-7" data-card>
            {t.icon === 'licencia' && (
              <svg class="a-draw h-9 w-9 text-copper" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="9" y="6" width="26" height="32" rx="2" />
                <path d="M15 15 H29 M15 21 H29 M15 27 H23" />
              </svg>
            )}
            {t.icon === 'infra' && (
              <svg class="a-draw h-9 w-9 text-copper" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="7" y="8" width="30" height="10" rx="2" />
                <rect x="7" y="26" width="30" height="10" rx="2" />
                <circle cx="13" cy="13" r="1.5" fill="currentColor" stroke="none" />
                <circle cx="13" cy="31" r="1.5" fill="currentColor" stroke="none" />
              </svg>
            )}
            {t.icon === 'seguridad' && (
              <svg class="a-draw h-9 w-9 text-copper" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M22 4 L38 10 V22 C38 32 30 38 22 40 C14 38 6 32 6 22 V10 Z" />
                <path d="M15 22 L20 27 L30 17" />
              </svg>
            )}
            <h3 class="display mt-5 text-xl">{t.titulo}</h3>
            <ul class="mt-4 space-y-2">
              {t.items.map((i) => (
                <li class="flex items-start gap-3 text-[0.92rem] leading-relaxed text-ink/70">
                  <span class="mt-[0.6rem] h-1.5 w-1.5 shrink-0 rounded-full bg-copper" aria-hidden="true" />
                  {i}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-6 rounded-2xl border border-ink/12 px-7 py-6 md:flex md:items-center md:justify-between md:gap-8" data-reveal>
      <p class="text-[0.95rem] leading-relaxed text-ink/75">
        <strong class="font-semibold text-ink">{t.mantenimientoLabel}</strong> {t.mantenimiento}
      </p>
      <p class="mt-2 text-[0.95rem] text-ink/60 md:mt-0 md:shrink-0">
        {t.mantenimientoNota}
      </p>
    </div>
  </div>
</section>
