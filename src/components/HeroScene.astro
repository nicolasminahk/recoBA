---
/**
 * Escena 3D del hero: el panel de administración inclinado en perspectiva y,
 * flotando a distintas profundidades, tarjetas reales del producto (cartera
 * del inversor, avisos, cámara de obra y carga desde el móvil). Se construye
 * solo con transformaciones CSS 3D; la interacción (ratón, scroll, flotación)
 * vive en src/scripts/hero.js. Sin JS o con reduced-motion queda la
 * composición estática, ya inclinada por CSS.
 */
import { Picture } from 'astro:assets';
import base from '../assets/shots/admin-obras.png';
import cartera from '../assets/shots/crops/cartera.png';
import atencion from '../assets/shots/crops/atencion.png';
import camara from '../assets/shots/crops/camara.png';
import movil from '../assets/shots/admin-movil-telefono.png';

const pic = {
  formats: ['avif'] as const,
  fallbackFormat: 'webp' as const,
  loading: 'eager' as const,
  decoding: 'async' as const,
  class: 'block h-auto w-full',
};
---

<div class="stage a-fade" data-hero-stage aria-label="Escena del producto">
  <div class="stage-tilt" data-stage-tilt>
    <div class="stage-inner" data-stage-inner>
      <!-- Capa base: el panel de obras -->
      <div class="layer layer-base" data-depth="0">
        <div class="shot-bar" aria-hidden="true">
          <span class="flex gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full border border-ink/20"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-ink/20"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-copper/60 bg-copper/30"></span>
          </span>
          <span class="shot-url">gestion.recoba.casa/admin</span>
        </div>
        <Picture
          src={base}
          alt="Panel de administración de recoBA: listado de obras con obras en curso, capital de inversores, pendientes de revisar, bandeja de entrada de correo y avisos que requieren atención"
          widths={[640, 960, 1280, 1800, 2304]}
          sizes="(min-width: 1200px) 1040px, calc(100vw - 2.5rem)"
          fetchpriority="high"
          {...pic}
        />
      </div>

      <!-- Tarjetas flotantes -->
      <figure class="layer card card-cartera" data-depth="1.5">
        <div class="card-inner" data-float>
          <figcaption class="card-tag">Portal del inversor · cartera</figcaption>
          <Picture
            src={cartera}
            alt="Resumen de cartera en el portal del inversor: capital invertido, valor estimado actual, distribuciones recibidas y TIR proyectada"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 560px, 80vw"
            {...pic}
          />
        </div>
      </figure>

      <figure class="layer card card-atencion" data-depth="1.1">
        <div class="card-inner" data-float>
          <figcaption class="card-tag">Panel · requiere atención</figcaption>
          <Picture
            src={atencion}
            alt="Lista de avisos del panel: un avance por publicar, entradas sin revisar, cierres de captación y un contrato que vence"
            widths={[360, 600, 900]}
            sizes="(min-width: 1024px) 330px, 60vw"
            {...pic}
          />
        </div>
      </figure>

      <figure class="layer card card-camara" data-depth="1.3">
        <div class="card-inner" data-float>
          <figcaption class="card-tag"><span class="live-dot" aria-hidden="true"></span>Cámara de obra · en directo</figcaption>
          <Picture
            src={camara}
            alt="Imagen en directo de la cámara de una obra con la fecha y la hora de la captura"
            widths={[360, 600, 900]}
            sizes="(min-width: 1024px) 340px, 60vw"
            {...pic}
          />
        </div>
      </figure>

      <figure class="layer card card-movil" data-depth="2">
        <div class="card-inner card-inner--phone" data-float>
          <Picture
            src={movil}
            alt="Carga de un avance de obra desde el móvil en tres pasos: foto, fase y nota"
            widths={[200, 320, 480]}
            sizes="(min-width: 1024px) 170px, 30vw"
            {...pic}
          />
        </div>
      </figure>
    </div>
  </div>
  <p class="stage-caption">Demo navegable · datos de demostración</p>
</div>

<style>
  .stage {
    position: relative;
    margin-inline: auto;
    max-width: 66rem;
    padding: 2rem 0 0;
    perspective: 1800px;
    perspective-origin: 50% 30%;
  }
  .stage-tilt {
    transform-style: preserve-3d;
    /* Inclinación estática (sin JS): la misma con la que arranca la animación */
    transform: rotateX(14deg) rotateY(-9deg);
  }
  .stage-inner {
    position: relative;
    transform-style: preserve-3d;
  }
  .layer {
    transform-style: preserve-3d;
  }
  .layer-base {
    overflow: hidden;
    border-radius: 0.9rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink) 6%, transparent),
      0 40px 90px -30px color-mix(in srgb, var(--color-ink) 45%, transparent);
  }
  .shot-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    background: var(--color-paper-2);
  }
  .shot-url {
    flex: 1;
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-ink) 50%, transparent);
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    background: #fff;
    padding: 0.2rem 0.8rem;
    white-space: nowrap;
  }

  /* Tarjetas flotantes: posición sobre el panel y profundidad (translateZ) */
  .card {
    position: absolute;
    margin: 0;
    transform: translateZ(var(--z, 60px));
  }
  .card-inner {
    overflow: hidden;
    border-radius: 0.8rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink) 8%, transparent),
      0 30px 60px -20px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }
  .card-inner--phone {
    border-radius: 1.3rem;
    border-width: 2px;
  }
  .card-tag {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-copper-deep);
    background: var(--color-paper);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-copper);
    animation: live-pulse 2.2s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-copper) 45%, transparent); }
    50% { box-shadow: 0 0 0 5px transparent; }
  }

  .card-cartera { --z: 90px; left: -6%; bottom: 14%; width: 54%; }
  .card-atencion { --z: 70px; right: -7%; top: -5%; width: 32%; }
  .card-camara { --z: 80px; right: -4%; bottom: -9%; width: 33%; }
  .card-movil { --z: 120px; left: 3%; top: -6%; width: 16%; }

  .stage-caption {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  @media (max-width: 1023px) {
    .stage { perspective: 1400px; }
    .stage-tilt { transform: rotateX(10deg) rotateY(-6deg); }
    .card-cartera { width: 62%; left: -4%; bottom: 10%; }
    .card-atencion { width: 40%; right: -5%; top: 8%; }
    .card-camara { display: none; }
    .card-movil { width: 20%; left: 2%; top: -4%; }
  }
  @media (max-width: 639px) {
    .stage { padding-top: 1rem; }
    .stage-tilt { transform: rotateX(8deg) rotateY(-3deg); }
    .card-atencion { display: none; }
    .card-cartera { width: 76%; left: 1%; bottom: 8%; }
    .card-movil { width: 26%; left: 3%; top: 2%; }
    .stage-caption { margin-top: 1.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
  }
</style>
