---
/**
 * El ciclo exprés en 4 pasos. Solo se cifra el total (6–8 meses); las
 * duraciones intermedias no se publican porque varían por operación.
 */
const pasos = [
  {
    fase: 'Mes 0',
    titulo: 'Compra',
    texto: 'Activo 20–30% bajo mercado, vía fideicomiso.',
    icon: 'lupa',
  },
  {
    fase: 'Obra',
    titulo: 'Reforma integral',
    texto: 'Llave en mano, con contingencia del 10%.',
    icon: 'obra',
  },
  {
    fase: 'Salida',
    titulo: 'A mercado',
    texto: 'Producto terminado donde la brecha es 30–37%.',
    icon: 'cartel',
  },
  {
    fase: 'Mes 6–8',
    titulo: 'Venta y reparto',
    texto: 'Capital y resultado, en dólares.',
    icon: 'monedas',
  },
];

const mailtoPaciente =
  'mailto:nicolasminahk@gmail.com?subject=Me%20interesa%20el%20flipping%20con%20alquiler';
---

<section id="proceso" class="relative overflow-hidden py-24 md:py-32">
  <div class="blob top-[10%] right-[10%] h-[28rem] w-[28rem] bg-copper/15" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 md:col-span-6">
        <p class="eyebrow text-copper" data-reveal>Cómo funciona</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
          Entrar y salir<br />en un mismo año
        </h2>
      </div>
      <div class="col-span-12 mt-6 flex items-end md:col-span-5 md:col-start-8 md:mt-0">
        <p class="text-lg text-ink/70" data-reveal>
          Sin esperar el ciclo: el margen se crea en la compra y se realiza con la
          venta del producto terminado.
        </p>
      </div>
    </div>

    <!-- Pasos con línea de progreso -->
    <div class="relative mt-16" data-proceso>
      <div
        class="absolute top-[7px] left-[7px] bottom-0 w-px bg-ink/12 lg:top-[26px] lg:right-0 lg:left-0 lg:bottom-auto lg:h-px lg:w-auto"
        aria-hidden="true"
      >
        <div
          class="h-full w-full origin-top scale-y-0 bg-copper lg:origin-left lg:scale-y-100 lg:scale-x-0"
          data-proceso-progress
        >
        </div>
      </div>

      <ol class="grid grid-cols-1 gap-y-10 lg:grid-cols-4 lg:gap-x-8">
        {
          pasos.map((p) => (
            <li class="relative pl-10 lg:pl-0" data-proceso-step>
              <span
                class="absolute top-0 left-0 flex h-[15px] w-[15px] items-center justify-center rounded-full border-[1.5px] border-ink/25 bg-paper lg:relative lg:top-auto lg:left-auto lg:mb-[11px] lg:h-[15px] lg:w-[15px]"
                data-proceso-dot
                aria-hidden="true"
              />
              {p.icon === 'lupa' && (
                <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <circle cx="17" cy="17" r="10" />
                  <line x1="24" y1="24" x2="34" y2="34" class="stroke-copper" />
                  <path d="M12 17 l4 4 7 -8" class="stroke-copper" />
                </svg>
              )}
              {p.icon === 'obra' && (
                <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="6" y="6" width="28" height="28" />
                  <line x1="6" y1="20" x2="34" y2="20" />
                  <line x1="20" y1="6" x2="20" y2="20" />
                  <path d="M11 28 l8 -5" class="stroke-copper" />
                  <path d="M23 29 l7 -4" class="stroke-copper" />
                </svg>
              )}
              {p.icon === 'cartel' && (
                <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="7" y="8" width="26" height="17" />
                  <line x1="12" y1="25" x2="12" y2="35" />
                  <line x1="13" y1="15" x2="27" y2="15" class="stroke-copper" />
                  <line x1="13" y1="20" x2="22" y2="20" class="stroke-copper" />
                </svg>
              )}
              {p.icon === 'monedas' && (
                <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <ellipse cx="20" cy="11" rx="12" ry="5" />
                  <path d="M8 11 V20 c0 2.8 5.4 5 12 5 s12 -2.2 12 -5 V11" />
                  <path d="M8 20 V29 c0 2.8 5.4 5 12 5 s12 -2.2 12 -5 V20" class="stroke-copper" />
                </svg>
              )}
              <p class="eyebrow mt-4 text-copper">{p.fase}</p>
              <h3 class="display mt-2 text-xl">{p.titulo}</h3>
              <p class="mt-2 text-[0.92rem] leading-relaxed text-ink/65">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Banda: la alternativa con alquiler, sin robar protagonismo -->
    <aside
      class="glass mt-16 flex flex-col items-start justify-between gap-5 rounded-2xl p-7 md:flex-row md:items-center md:p-8"
      data-reveal
    >
      <div class="flex items-start gap-4">
        <svg class="a-draw mt-0.5 h-9 w-9 shrink-0 text-ink/60" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="18" cy="18" r="13" />
          <path d="M18 10 v8 l6 4" class="stroke-copper" />
        </svg>
        <p class="max-w-[46rem] text-[0.98rem] leading-relaxed text-ink/75">
          <strong>¿Prefieres flujo antes que salida rápida?</strong> También operamos
          en modalidad paciente: rentamos el activo en dólares 3–5 años y vendemos
          más adelante.
        </p>
      </div>
      <a href={mailtoPaciente} class="btn btn-ghost shrink-0 !py-3 text-[0.88rem]" data-magnetic>
        Cuéntame esa opción <span class="arr" aria-hidden="true">→</span>
      </a>
    </aside>
  </div>
</section>
