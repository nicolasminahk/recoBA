---
const hitos = [
  {
    fase: 'Mes 0',
    titulo: 'Originación y compra',
    texto: 'Vía fideicomiso, con el descuento ya negociado.',
    icon: 'lupa',
  },
  {
    fase: 'Meses 1–8',
    titulo: 'Reforma integral',
    texto: 'Llave en mano, contingencia presupuestada.',
    icon: 'obra',
  },
  {
    fase: 'Mes 8',
    titulo: 'Puesta en renta',
    texto: 'Renta temporal premium, siempre en dólares.',
    icon: 'llave',
  },
  {
    fase: 'Años 1–5',
    titulo: 'Renta trimestral',
    texto: 'Preferente 6% anual en USD, acumulativa.',
    icon: 'monedas',
  },
  {
    fase: 'Año 3–5',
    titulo: 'Venta y reparto',
    texto: 'Preferente → 100% capital → plusvalía 80/20.',
    icon: 'salida',
  },
];
---

<section id="modelo" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-copper" data-reveal>El modelo</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
        Del piso a reciclar<br />al reparto final
      </h2>
      <p class="mt-6 text-lg text-ink/70" data-reveal>
        Un ciclo de 3 a 5 años, con reporting en cada hito.
      </p>
    </div>

    <!-- Timeline: horizontal con pin+scrub en desktop, vertical en móvil -->
    <div class="relative mt-16" data-timeline>
      <!-- línea de progreso -->
      <div
        class="absolute top-0 bottom-0 left-[7px] w-px bg-ink/12 lg:top-[5px] lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-auto"
        aria-hidden="true"
      >
        <div
          class="h-full w-full origin-top scale-y-0 bg-copper lg:origin-left lg:scale-y-100 lg:scale-x-0"
          data-timeline-progress
        >
        </div>
      </div>

      <ol class="grid grid-cols-1 gap-y-10 lg:grid-cols-5 lg:gap-x-8">
        {
          hitos.map((h) => (
            <li class="relative pl-9 lg:pl-0" data-timeline-item>
              <span
                class="absolute top-[3px] left-0 block h-[15px] w-[15px] rounded-full border-[1.5px] border-ink/30 bg-paper transition-colors duration-300 lg:relative lg:top-auto lg:left-auto lg:-mt-[2px]"
                data-timeline-dot
                aria-hidden="true"
              />
              {h.icon === 'lupa' && (
                <svg class="a-draw mt-0 h-9 w-9 text-ink lg:mt-7" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <circle cx="15" cy="15" r="9" />
                  <line x1="22" y1="22" x2="31" y2="31" class="stroke-copper" />
                  <path d="M11 15 L14 18 L20 12" class="stroke-copper" />
                </svg>
              )}
              {h.icon === 'obra' && (
                <svg class="a-draw mt-0 h-9 w-9 text-ink lg:mt-7" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="5" y="5" width="26" height="26" />
                  <line x1="5" y1="18" x2="31" y2="18" />
                  <line x1="18" y1="5" x2="18" y2="18" />
                  <path d="M10 26 L17 22" class="stroke-copper" />
                  <path d="M21 27 L27 23" class="stroke-copper" />
                </svg>
              )}
              {h.icon === 'llave' && (
                <svg class="a-draw mt-0 h-9 w-9 text-ink lg:mt-7" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="9" y="5" width="18" height="28" />
                  <path d="M27 33 a18 18 0 0 0 -18 0" stroke-opacity="0.45" />
                  <circle cx="22.5" cy="19" r="1.6" class="stroke-copper" />
                  <line x1="4" y1="33" x2="32" y2="33" />
                </svg>
              )}
              {h.icon === 'monedas' && (
                <svg class="a-draw mt-0 h-9 w-9 text-ink lg:mt-7" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <ellipse cx="18" cy="10" rx="11" ry="4.5" />
                  <path d="M7 10 V18 c0 2.5 4.9 4.5 11 4.5 s11 -2 11 -4.5 V10" />
                  <path d="M7 18 V26 c0 2.5 4.9 4.5 11 4.5 s11 -2 11 -4.5 V18" class="stroke-copper" />
                </svg>
              )}
              {h.icon === 'salida' && (
                <svg class="a-draw mt-0 h-9 w-9 text-ink lg:mt-7" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <polyline points="5,29 13,21 19,25 31,11" class="stroke-copper" />
                  <polyline points="23,11 31,11 31,19" class="stroke-copper" />
                  <line x1="5" y1="33" x2="31" y2="33" />
                </svg>
              )}
              <p class="eyebrow mt-4 text-copper">{h.fase}</p>
              <h3 class="display mt-2 text-xl">{h.titulo}</h3>
              <p class="mt-2.5 text-[0.92rem] leading-relaxed text-ink/65">{h.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <aside
      class="mt-16 flex flex-col items-start justify-between gap-6 rounded-2xl bg-ink p-8 text-paper md:flex-row md:items-center md:p-10"
      data-reveal
    >
      <div>
        <p class="display text-2xl md:text-3xl">Tú inviertes, nosotros operamos.</p>
        <p class="mt-2 max-w-[38rem] text-paper/65">
          Un solo interlocutor de principio a fin.
        </p>
      </div>
      <a
        href="#co-inversion"
        class="btn btn-ghost-light shrink-0"
        data-magnetic
      >
        Cómo funciona la co-inversión <span class="arr" aria-hidden="true">→</span>
      </a>
    </aside>
  </div>
</section>
