---
/**
 * El ciclo completo como diagrama que se bifurca: compra y reforma comunes,
 * luego salida exprés (venta mes 8–12) o paciente (renta → venta año 3–5).
 * Desktop: SVG con pin + scrub. Móvil: versión vertical apilada.
 */
---

<section id="modelo" class="relative py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid opacity-70" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-copper" data-reveal>El modelo</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
        Un ciclo, dos salidas
      </h2>
    </div>

    <!-- Desktop: diagrama bifurcado con scrub -->
    <div class="mt-10 hidden lg:block" data-fork>
      <svg
        viewBox="0 0 1200 430"
        class="h-auto w-full"
        fill="none"
        role="img"
        aria-label="Diagrama del ciclo: mes 0 compra vía fideicomiso, meses 1 a 8 reforma integral; después el camino se bifurca en salida exprés (venta y reparto en el mes 8 a 12) o salida paciente (renta trimestral en dólares y venta con cascada en el año 3 a 5)."
      >
        <!-- tronco común -->
        <path d="M 40 215 H 470" stroke="#16181D" stroke-opacity="0.35" stroke-width="2" data-fork-trunk />
        <!-- rama exprés (salvia, arriba) -->
        <path d="M 470 215 C 560 215 555 110 650 110 H 1150" stroke="#4F5D53" stroke-width="2" data-fork-expres />
        <!-- rama paciente (cobre, abajo) -->
        <path d="M 470 215 C 560 215 555 320 650 320 H 1150" stroke="#C2603D" stroke-width="2" data-fork-paciente />

        <!-- nodos tronco -->
        <g data-fork-node>
          <circle cx="60" cy="215" r="7" fill="#F7F3EC" stroke="#16181D" stroke-width="1.5" />
          <text x="60" y="180" text-anchor="middle" font-size="12" letter-spacing="2" fill="#C2603D" font-weight="600">MES 0</text>
          <text x="60" y="252" text-anchor="middle" font-size="15.5" fill="#16181D" font-weight="600">Compra</text>
          <text x="60" y="272" text-anchor="middle" font-size="12.5" fill="#16181D" opacity="0.55">vía fideicomiso</text>
        </g>
        <g data-fork-node>
          <circle cx="300" cy="215" r="7" fill="#F7F3EC" stroke="#16181D" stroke-width="1.5" />
          <text x="300" y="180" text-anchor="middle" font-size="12" letter-spacing="2" fill="#C2603D" font-weight="600">MESES 1–8</text>
          <text x="300" y="252" text-anchor="middle" font-size="15.5" fill="#16181D" font-weight="600">Reforma integral</text>
          <text x="300" y="272" text-anchor="middle" font-size="12.5" fill="#16181D" opacity="0.55">llave en mano</text>
        </g>

        <!-- bifurcación -->
        <g data-fork-node>
          <circle cx="470" cy="215" r="8" fill="#C2603D" />
          <text x="470" y="188" text-anchor="middle" font-size="12" letter-spacing="2" fill="#16181D" opacity="0.6" font-weight="600">ELIGES</text>
        </g>

        <!-- rama exprés: nodos -->
        <g data-fork-node-e>
          <circle cx="760" cy="110" r="7" fill="#F7F3EC" stroke="#4F5D53" stroke-width="1.5" />
          <text x="760" y="76" text-anchor="middle" font-size="12" letter-spacing="2" fill="#4F5D53" font-weight="600">MES 8–12</text>
          <text x="760" y="145" text-anchor="middle" font-size="15.5" fill="#16181D" font-weight="600">Venta y reparto</text>
        </g>
        <g data-fork-node-e>
          <text x="1150" y="100" text-anchor="end" font-size="13.5" fill="#4F5D53" font-weight="600">FLIP EXPRÉS</text>
          <text x="1150" y="122" text-anchor="end" font-size="12.5" fill="#16181D" opacity="0.6">capital de vuelta &lt; 1 año</text>
        </g>

        <!-- rama paciente: nodos -->
        <g data-fork-node-p>
          <circle cx="700" cy="320" r="7" fill="#F7F3EC" stroke="#C2603D" stroke-width="1.5" />
          <text x="700" y="286" text-anchor="middle" font-size="12" letter-spacing="2" fill="#C2603D" font-weight="600">AÑOS 1–5</text>
          <text x="700" y="355" text-anchor="middle" font-size="15.5" fill="#16181D" font-weight="600">Renta trimestral</text>
          <text x="700" y="375" text-anchor="middle" font-size="12.5" fill="#16181D" opacity="0.55">preferente 6% USD</text>
        </g>
        <g data-fork-node-p>
          <circle cx="990" cy="320" r="7" fill="#F7F3EC" stroke="#C2603D" stroke-width="1.5" />
          <text x="990" y="286" text-anchor="middle" font-size="12" letter-spacing="2" fill="#C2603D" font-weight="600">AÑO 3–5</text>
          <text x="990" y="355" text-anchor="middle" font-size="15.5" fill="#16181D" font-weight="600">Venta y cascada</text>
          <text x="990" y="375" text-anchor="middle" font-size="12.5" fill="#16181D" opacity="0.55">pref. → capital → 80/20</text>
        </g>
        <g data-fork-node-p>
          <text x="1150" y="310" text-anchor="end" font-size="13.5" fill="#C2603D" font-weight="600">FLIPPING PACIENTE</text>
          <text x="1150" y="332" text-anchor="end" font-size="12.5" fill="#16181D" opacity="0.6">TIR objetivo 9–12% USD</text>
        </g>
      </svg>
    </div>

    <!-- Móvil: versión vertical -->
    <div class="mt-12 lg:hidden">
      <ol class="relative flex flex-col gap-8 border-l border-ink/15 pl-6">
        <li data-reveal>
          <p class="eyebrow text-copper">Mes 0 · Compra</p>
          <p class="mt-1 text-[0.92rem] text-ink/65">Vía fideicomiso, descuento ya negociado.</p>
        </li>
        <li data-reveal>
          <p class="eyebrow text-copper">Meses 1–8 · Reforma integral</p>
          <p class="mt-1 text-[0.92rem] text-ink/65">Llave en mano, contingencia presupuestada.</p>
        </li>
      </ol>
      <p class="eyebrow mt-8 text-ink/50" data-reveal>Aquí eliges la salida</p>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-sage/40 bg-paper p-6" data-reveal>
          <p class="eyebrow text-sage">Flip exprés</p>
          <p class="display mt-2 text-lg">Mes 8–12 · Venta y reparto</p>
          <p class="mt-2 text-[0.88rem] text-ink/60">Capital de vuelta en menos de un año.</p>
        </div>
        <div class="rounded-2xl border border-copper/40 bg-paper p-6" data-reveal>
          <p class="eyebrow text-copper">Flipping paciente</p>
          <p class="display mt-2 text-lg">Renta 6% USD → venta año 3–5</p>
          <p class="mt-2 text-[0.88rem] text-ink/60">Cascada: preferente → capital → 80/20.</p>
        </div>
      </div>
    </div>

    <aside
      class="mt-14 flex flex-col items-start justify-between gap-6 rounded-2xl bg-ink p-8 text-paper md:flex-row md:items-center md:p-10"
      data-reveal
    >
      <div>
        <p class="display text-2xl md:text-3xl">Tú inviertes, nosotros operamos.</p>
        <p class="mt-2 max-w-[38rem] text-paper/65">
          Un solo interlocutor de principio a fin.
        </p>
      </div>
      <a href="#co-inversion" class="btn btn-ghost-light shrink-0" data-magnetic>
        Cómo funciona la co-inversión <span class="arr" aria-hidden="true">→</span>
      </a>
    </aside>
  </div>
</section>
