---
import { mailtoDemo, EMAIL, DEMO_PORTAL, DEMO_ADMIN } from '../data/site.js';
import { useT, getLang } from '../i18n/index.js';

const t = useT(Astro).cta;
const ctaDemo = useT(Astro).common.ctaDemo;
const MAILTO_DEMO = mailtoDemo(getLang(Astro));
const { pasos } = t;
---

<section id="demo" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div
      class="relative overflow-hidden rounded-3xl bg-ink px-6 py-14 text-paper md:px-14 md:py-20"
      data-reveal
    >
      <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>
      <div class="blob top-[-20%] right-[-5%] h-[26rem] w-[26rem] bg-copper/25" aria-hidden="true"></div>

      <div class="relative grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 lg:col-span-6">
          <svg
            class="a-draw h-12 w-12 text-copper"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M16 52 V34 a16 16 0 0 1 32 0 V52" />
            <line x1="10" y1="52" x2="54" y2="52" />
          </svg>
          <h2 class="display mt-6 max-w-[30rem] text-[clamp(2rem,4.2vw,3.6rem)]">
            {t.title}
          </h2>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={MAILTO_DEMO} class="btn btn-copper !px-8 !py-4 text-base" data-magnetic>
              {ctaDemo} <span class="arr" aria-hidden="true">→</span>
            </a>
          </div>
          <p class="mt-4 text-[0.9rem] text-paper/60">
            {t.writeTo}{' '}
            <a href={`mailto:${EMAIL}`} class="select-all font-medium text-paper hover:text-copper">{EMAIL}</a>
          </p>

          <p class="mt-8 text-[0.85rem] text-paper/50">
            {t.demosLabel}
            <a href={DEMO_PORTAL} target="_blank" rel="noopener" class="ml-1 text-paper/80 hover:text-copper"
              >{t.portal} <span aria-hidden="true">↗</span></a
            >
            <span class="mx-1.5" aria-hidden="true">·</span>
            <a href={DEMO_ADMIN} target="_blank" rel="noopener" class="text-paper/80 hover:text-copper"
              >{t.admin} <span aria-hidden="true">↗</span></a
            >
          </p>
        </div>

        <ol class="col-span-12 lg:col-span-5 lg:col-start-8">
          {
            pasos.map(([t, d], i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-paper/15 py-5 first:border-t-0 first:pt-0 lg:first:border-t lg:first:pt-5">
                <span class="display tnum text-xl text-copper" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="display text-lg">{t}</h3>
                  <p class="mt-1.5 text-[0.9rem] leading-relaxed text-paper/60">{d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
