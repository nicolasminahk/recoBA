---
const mailto =
  'mailto:nicolasminahk@gmail.com?subject=Quiero%20saber%20m%C3%A1s%20sobre%20recoBA';
---

<section id="hablemos" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div
      class="relative overflow-hidden rounded-3xl bg-ink px-8 py-16 text-center text-paper md:py-20"
      data-reveal
    >
      <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>
      <svg
        class="a-draw relative mx-auto h-14 w-14 text-copper"
        viewBox="0 0 64 64"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M16 52 V34 a16 16 0 0 1 32 0 V52" />
        <line x1="10" y1="52" x2="54" y2="52" />
      </svg>
      <h2 class="display relative mx-auto mt-6 max-w-[34rem] text-[clamp(2.2rem,5vw,4rem)]">
        ¿Hablamos?
      </h2>
      <p class="relative mx-auto mt-5 max-w-[32rem] text-lg text-paper/70">
        Treinta minutos con los números delante. Estamos cerrando la operación
        piloto de 2026.
      </p>
      <div class="relative mt-9">
        <a href={mailto} class="btn btn-copper !px-8 !py-4 text-base" data-magnetic>
          Agenda una llamada <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="relative mt-5 text-[0.85rem] text-paper/45">nicolasminahk@gmail.com</p>
    </div>
  </div>
</section>
