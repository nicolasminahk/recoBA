---
const riesgos = [
  {
    titulo: 'Cambiario y repatriación',
    riesgo: 'Argentina tiene historial de cepos y restricciones.',
    mitigacion: 'Operativa 100% en USD billete: compra, renta y venta.',
    icon: 'divisa',
  },
  {
    titulo: 'Reversibilidad fiscal',
    riesgo: 'La exención de 2026 puede revertirse con otro gobierno.',
    mitigacion: 'Los escenarios no dependen de la exención.',
    icon: 'balanza',
  },
  {
    titulo: 'Ejecución de obra',
    riesgo: 'Toda reforma puede desviarse en coste o plazo.',
    mitigacion: 'Contingencia del 10% y contrato llave en mano.',
    icon: 'casco',
  },
  {
    titulo: 'Compresión de la renta',
    riesgo: 'Más oferta temporal puede comprimir ADR y ocupación.',
    mitigacion: 'Percentil 75+ y plan B: alquiler tradicional en USD.',
    icon: 'cama',
  },
  {
    titulo: 'Liquidez',
    riesgo: 'Sin mercado secundario: no se vende con un clic.',
    mitigacion: 'Horizonte 3–5 años y activo real siempre vendible.',
    icon: 'reloj',
  },
  {
    titulo: 'Ciclo político',
    riesgo: 'Elecciones 2027: el clima puede cambiar.',
    mitigacion: 'Ventana de venta flexible; la renta USD paga la espera.',
    icon: 'urna',
  },
];
---

<section id="riesgos" class="relative bg-paper-2 py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-copper" data-reveal>Transparencia radical</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
        Riesgos, sin letra pequeña
      </h2>
      <p class="mt-6 text-lg text-ink/70" data-reveal>
        Los seis riesgos reales — y cómo los mitigamos.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        riesgos.map((r) => (
          <article class="row-lift flex flex-col rounded-2xl border border-ink/10 bg-paper p-7" data-riesgo-card>
            {r.icon === 'divisa' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="20" cy="20" r="15" />
                <path d="M20 11 V29 M25 14.5 c-1.4 -1.5 -8.5 -2.6 -8.5 1.8 c0 4.1 8.8 2.6 8.8 7 c0 4 -6.8 3.6 -9.3 1.7" class="stroke-copper" />
              </svg>
            )}
            {r.icon === 'balanza' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <line x1="20" y1="6" x2="20" y2="32" />
                <line x1="8" y1="10" x2="32" y2="10" />
                <path d="M8 10 L4 20 h8 Z" class="stroke-copper" />
                <path d="M32 10 L28 20 h8 Z" class="stroke-copper" />
                <line x1="13" y1="34" x2="27" y2="34" />
              </svg>
            )}
            {r.icon === 'casco' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 26 a14 14 0 0 1 28 0" />
                <line x1="4" y1="26" x2="36" y2="26" />
                <path d="M16 12 v6 M24 12 v6" class="stroke-copper" />
                <line x1="8" y1="31" x2="32" y2="31" />
              </svg>
            )}
            {r.icon === 'cama' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12 V30 M5 24 H35 V30" />
                <path d="M5 24 V18 H35 V24" />
                <circle cx="11" cy="20" r="2.5" class="stroke-copper" />
              </svg>
            )}
            {r.icon === 'reloj' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="20" cy="20" r="15" />
                <path d="M20 11 V20 L27 24" class="stroke-copper" />
              </svg>
            )}
            {r.icon === 'urna' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="7" y="16" width="26" height="18" />
                <line x1="15" y1="16" x2="25" y2="16" class="stroke-copper" stroke-width="2" />
                <path d="M17 12 L23 6 L27 10 L21 16" class="stroke-copper" />
              </svg>
            )}
            <h3 class="display mt-5 text-xl">{r.titulo}</h3>
            <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ink/65">{r.riesgo}</p>
            <div class="mt-auto pt-5">
              <p class="eyebrow text-copper">Mitigación</p>
              <p class="mt-2 border-l-2 border-copper/50 pl-4 text-[0.9rem] leading-relaxed text-ink/75">
                {r.mitigacion}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
