---
const riesgos = [
  {
    titulo: 'Precio y tiempo de venta',
    riesgo: 'El comprador puede tardar, o pagar menos de lo proyectado.',
    mitigacion:
      'El colchón se compra: entrar 20–30% bajo mercado. Si la ventana se cierra, rentamos en USD y vendemos más adelante.',
    icon: 'cartel',
  },
  {
    titulo: 'Ejecución de obra',
    riesgo: 'Toda reforma puede desviarse en coste o plazo.',
    mitigacion: 'Contingencia del 10% y contrato llave en mano con el constructor.',
    icon: 'casco',
  },
  {
    titulo: 'Cambiario',
    riesgo: 'Argentina tiene historial de cepos y restricciones.',
    mitigacion: 'Operativa 100% en USD billete: compra, obra y venta.',
    icon: 'divisa',
  },
  {
    titulo: 'Ciclo político y fiscal',
    riesgo: 'Elecciones 2027 y una exención de 2026 que puede revertirse.',
    mitigacion:
      'El ciclo corto reduce la exposición y los escenarios no dependen de la exención.',
    icon: 'balanza',
  },
];
---

<section id="riesgos" class="relative bg-paper-2 py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-copper" data-reveal>Transparencia radical</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
        Riesgos, sin letra pequeña
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        riesgos.map((r) => (
          <article class="row-lift flex flex-col rounded-2xl border border-ink/10 bg-paper p-7" data-riesgo-card>
            {r.icon === 'cartel' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="7" y="8" width="26" height="17" />
                <line x1="12" y1="25" x2="12" y2="35" />
                <line x1="13" y1="15" x2="27" y2="15" class="stroke-copper" />
                <line x1="13" y1="20" x2="22" y2="20" class="stroke-copper" />
              </svg>
            )}
            {r.icon === 'casco' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 26 a14 14 0 0 1 28 0" />
                <line x1="4" y1="26" x2="36" y2="26" />
                <path d="M16 12 v6 M24 12 v6" class="stroke-copper" />
                <line x1="8" y1="31" x2="32" y2="31" />
              </svg>
            )}
            {r.icon === 'divisa' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="20" cy="20" r="15" />
                <path d="M20 11 V29 M25 14.5 c-1.4 -1.5 -8.5 -2.6 -8.5 1.8 c0 4.1 8.8 2.6 8.8 7 c0 4 -6.8 3.6 -9.3 1.7" class="stroke-copper" />
              </svg>
            )}
            {r.icon === 'balanza' && (
              <svg class="a-draw h-10 w-10 text-ink" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <line x1="20" y1="6" x2="20" y2="32" />
                <line x1="8" y1="10" x2="32" y2="10" />
                <path d="M8 10 L4 20 h8 Z" class="stroke-copper" />
                <path d="M32 10 L28 20 h8 Z" class="stroke-copper" />
                <line x1="13" y1="34" x2="27" y2="34" />
              </svg>
            )}
            <h3 class="display mt-5 text-lg">{r.titulo}</h3>
            <p class="mt-2.5 text-[0.88rem] leading-relaxed text-ink/65">{r.riesgo}</p>
            <div class="mt-auto pt-5">
              <p class="eyebrow text-copper">Mitigación</p>
              <p class="mt-2 border-l-2 border-copper/50 pl-4 text-[0.88rem] leading-relaxed text-ink/75">
                {r.mitigacion}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
