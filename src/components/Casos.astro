      { esc: 'Conservador', neta: '6.789', yield: '4,9%', cob: '0,81x' },
      { esc: 'Base', neta: '9.188', yield: '6,6%', cob: '1,10x' },
      { esc: 'Optimista', neta: '11.768', yield: '8,5%', cob: '1,41x' },
    ],
    tickets: null,
    plano: false,
  },
];

// Geometría del waterfall (viewBox 720×320, área de barras 240px de alto)
function waterfall(inversion: Segmento[], total: number) {
  const chartH = 220;
  const base = 258;
  const slot = 720 / (inversion.length + 1);
  const barW = 62;
  let cum = 0;
  const segs = inversion.map((s, i) => {
    const start = cum;
    cum += s.val;
    const h = (s.val / total) * chartH;
    const yTop = base - (cum / total) * chartH;
    return {
      ...s,
      x: slot * i + (slot - barW) / 2,
      y: yTop,
      h,
      cx: slot * i + slot / 2,
      connY: yTop,
    };
  });
  return { segs, slot, barW, base, totalX: slot * inversion.length + (slot - barW) / 2, totalY: base - chartH, totalH: chartH };
}

const escalas = ['Conservador', 'Base', 'Optimista'];
// Geometría barras TIR (viewBox 680×270, máx. 16%)
function tirBars(proyecto: number[], inversor: number[]) {
  const chartH = 180;
  const base = 214;
  const groupW = 680 / 3;
  const barW = 52;
  return escalas.map((esc, i) => {
    const gx = groupW * i;
    return {
      esc,
      p: { x: gx + groupW / 2 - barW - 6, h: (proyecto[i] / 16) * chartH, w: barW },
      inv: { x: gx + groupW / 2 + 6, h: (inversor[i] / 16) * chartH, w: barW },
      base,
    };
  });
}
---

<section id="casos" class="relative bg-paper-2 py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-copper" data-reveal>Los números</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
        Casos, con todas<br />las cifras sobre la mesa
      </h2>
      <p class="mt-6 text-lg text-ink/70" data-reveal>
        Un caso real en análisis y el caso tipo de la metodología, modelados con
        <strong>flipping paciente</strong>. Siempre a tres escenarios.
      </p>
    </div>

    <!-- Tabs -->
    <div
      class="mt-12 flex w-full flex-col gap-1 rounded-2xl border border-ink/15 bg-paper p-1 sm:inline-flex sm:w-auto sm:flex-row sm:rounded-full"
      role="tablist"
      aria-label="Selección de caso"
      data-reveal
    >
      {
        casos.map((c, i) => (
          <button
            role="tab"
            id={`tab-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${c.id}`}
            data-tab={c.id}
            class="rounded-full px-5 py-2.5 text-[0.9rem] font-semibold transition-colors aria-selected:bg-ink aria-selected:text-paper"
          >
            {c.tab}
          </button>
        ))
      }
    </div>

    {
      casos.map((c, idx) => {
        const wf = waterfall(c.inversion, c.total);
        const tir = tirBars(c.tirProyecto, c.tirInversor);
        return (
          <div
            id={`panel-${c.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${c.id}`}
            data-panel={c.id}
            class:list={['mt-10', { hidden: idx !== 0 }]}
          >
            <!-- Cabecera del caso -->
            <div class="grid grid-cols-12 gap-6">
              <div class="col-span-12 rounded-2xl border border-ink/10 bg-paper p-8 md:p-10 lg:col-span-7">
                <span class="eyebrow inline-block rounded-full bg-copper px-3.5 py-1.5 text-paper">
                  {c.badge}
                </span>
                <h3 class="display mt-5 text-[clamp(1.8rem,3vw,2.6rem)]">{c.titulo}</h3>
                <p class="mt-4 leading-relaxed text-ink/75">{c.intro}</p>
                <p class="mt-3 leading-relaxed text-ink/75">{c.plan}</p>
                <p class="mt-5 text-[0.8rem] text-ink/45">{c.disclaimer}</p>
                <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-ink/10 pt-6 sm:grid-cols-4">
                  {c.specs.map((s) => (
                    <div>
                      <dt class="eyebrow text-ink/45">{s.k}</dt>
                      <dd class="display tnum mt-1.5 text-xl">{s.v}</dd>
                    </div>
                  ))}
                </dl>
              </div>

              <div class="col-span-12 flex flex-col gap-6 lg:col-span-5">
                {c.plano ? (
                  <figure class="flex-1 rounded-2xl border border-ink/10 bg-paper p-8">
                    <figcaption class="eyebrow text-ink/45">
                      Plano objetivo · 1 dormitorio + home office
                    </figcaption>
                    <svg
                      class="a-draw mt-4 h-auto w-full max-w-[24rem] text-ink"
                      viewBox="0 0 400 260"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      role="img"
                      aria-label="Plano de planta esquemático: estar-comedor integrado con cocina, dormitorio en suite y home office."
                    >
                      <rect x="10" y="10" width="380" height="240" />
                      <line x1="180" y1="10" x2="180" y2="150" />
                      <line x1="180" y1="150" x2="10" y2="150" />
                      <line x1="180" y1="90" x2="280" y2="90" stroke-opacity="0.5" />
                      <line x1="280" y1="10" x2="280" y2="90" />
                      <path d="M180 110 a20 20 0 0 1 20 20" class="stroke-copper" stroke-width="1.2" />
                      <line x1="180" y1="110" x2="180" y2="130" class="stroke-copper" stroke-width="1.2" />
                      <path d="M90 150 a22 22 0 0 1 22 22" class="stroke-copper" stroke-width="1.2" />
                      <rect x="300" y="30" width="70" height="12" stroke-opacity="0.6" />
                      <rect x="40" y="40" width="90" height="50" stroke-opacity="0.6" />
                      <rect x="40" y="180" width="120" height="50" stroke-opacity="0.6" />
                      <text x="55" y="130" font-size="11" fill="currentColor" stroke="none" class="font-sans" opacity="0.6">DORMITORIO</text>
                      <text x="210" y="55" font-size="11" fill="currentColor" stroke="none" opacity="0.6">HOME OFFICE</text>
                      <text x="215" y="200" font-size="11" fill="currentColor" stroke="none" opacity="0.6">ESTAR · COMEDOR</text>
                      <text x="300" y="120" font-size="11" fill="currentColor" stroke="none" opacity="0.6">COCINA</text>
                    </svg>
                  </figure>
                ) : (
                  <div class="ph flex flex-1 items-center justify-center rounded-2xl p-8 text-center">
                    <p class="max-w-[16rem] text-[0.85rem] text-ink/50">
                      Reservado para fotografía real de obra terminada
                      <span class="mt-1 block text-[0.72rem] text-ink/35">
                        (placeholder documentado — sin fotos de stock)
                      </span>
                    </p>
                  </div>
                )}

                <div class="rounded-2xl bg-ink p-8 text-paper">
                  <p class="eyebrow text-paper/50">Valor post-reforma · 3 escenarios</p>
                  <div class="mt-4 flex flex-wrap items-end gap-x-7 gap-y-3">
                    {c.valorPost.map((v, i) => (
                      <div>
                        <p class="display tnum text-[1.7rem] leading-none" class:list={[i === 1 && 'text-copper']}>
                          US$ {v}
                        </p>
                        <p class="eyebrow mt-1.5 text-paper/45">{escalas[i]}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Waterfall de inversión -->
            <figure
              class="mt-6 rounded-2xl border border-ink/10 bg-paper p-8 md:p-10"
              data-chart-waterfall
              aria-label={`Desglose de la inversión total de ${c.totalFmt} dólares: compra ${c.inversion[0].fmt}, costes de compra ${c.inversion[1].fmt}, reforma ${c.inversion[2].fmt}, contingencia ${c.inversion[3].fmt}, equipamiento ${c.inversion[4].fmt} y holding de obra ${c.inversion[5].fmt}.`}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <figcaption class="eyebrow text-ink/45">Desglose de la inversión · US$</figcaption>
                <p class="display tnum text-xl">
                  Total US$ {c.totalFmt} <span class="ml-2 text-[0.8rem] font-normal text-ink/45">{c.allin}</span>
                </p>
              </div>
              <div class="overflow-x-auto">
                <svg viewBox="0 0 720 320" class="mt-6 h-auto w-full min-w-[640px]" role="presentation">
                  <line x1="0" y1="258" x2="720" y2="258" stroke="#16181D" stroke-opacity="0.15" />
                  {wf.segs.map((s, i) => (
                    <g>
                      <rect
                        x={s.x}
                        y={s.y}
                        width={wf.barW}
                        height={s.h}
                        rx="2"
                        class={i === 0 ? 'fill-sage' : 'fill-stone'}
                        opacity={i === 0 ? '0.9' : '0.8'}
                        data-wf-seg
                        style="transform-box: fill-box; transform-origin: center bottom;"
                      />
                      {i < wf.segs.length - 1 && (
                        <line
                          x1={s.x + wf.barW}
                          y1={s.y}
                          x2={wf.segs[i + 1].x}
                          y2={s.y}
                          stroke="#16181D"
                          stroke-opacity="0.25"
                          stroke-dasharray="3 3"
                          data-wf-conn
                        />
                      )}
                      <text x={s.cx} y={s.y - 8} text-anchor="middle" font-size="13" font-weight="600" class="fill-ink tnum" data-wf-label>
                        {s.fmt}
                      </text>
                      <text x={s.cx} y="280" text-anchor="middle" font-size="11" class="fill-ink" opacity="0.55">
                        {s.label}
                      </text>
                    </g>
                  ))}
                  <g>
                    <line
                      x1={wf.segs[5].x + wf.barW}
                      y1={wf.totalY}
                      x2={wf.totalX}
                      y2={wf.totalY}
                      stroke="#16181D"
                      stroke-opacity="0.25"
                      stroke-dasharray="3 3"
                      data-wf-conn
                    />
                    <rect
                      x={wf.totalX}
                      y={wf.totalY}
                      width={wf.barW}
                      height={wf.totalH}
                      rx="2"
                      class="fill-copper"
                      data-wf-seg
                      style="transform-box: fill-box; transform-origin: center bottom;"
                    />
                    <text
                      x={wf.totalX + wf.barW / 2}
                      y={wf.totalY - 8}
                      text-anchor="middle"
                      font-size="13"
                      font-weight="600"
                      class="fill-copper tnum"
                      data-wf-label
                    >
                      {c.totalFmt}
                    </text>
                    <text x={wf.totalX + wf.barW / 2} y="280" text-anchor="middle" font-size="11" class="fill-ink" opacity="0.55">
                      Total
                    </text>
                  </g>
                </svg>
              </div>
            </figure>

            <div class="mt-6 grid grid-cols-12 gap-6">
              <!-- Barras TIR -->
              <figure
                class="col-span-12 rounded-2xl border border-ink/10 bg-paper p-8 md:p-10 lg:col-span-6"
                data-chart-tir
                aria-label={`TIR a 5 años por escenario. Proyecto: ${c.tirProyectoFmt.join(', ')}. Inversor tras la cascada de retorno: ${c.tirInversorFmt.join(', ')}.`}
              >
                <figcaption class="eyebrow text-ink/45">TIR a 5 años · USD</figcaption>
                <svg viewBox="0 0 680 270" class="mt-6 h-auto w-full" role="presentation">
                  {[0, 4, 8, 12, 16].map((v) => (
                    <g>
                      <line
                        x1="0"
                        y1={214 - (v / 16) * 180}
                        x2="680"
                        y2={214 - (v / 16) * 180}
                        stroke="#16181D"
                        stroke-opacity={v === 0 ? '0.2' : '0.07'}
                      />
                      <text x="0" y={210 - (v / 16) * 180} font-size="10" class="fill-ink tnum" opacity="0.4">
                        {v}%
                      </text>
                    </g>
                  ))}
                  {tir.map((g, i) => (
                    <g>
                      <rect
                        x={g.p.x}
                        y={g.base - g.p.h}
                        width={g.p.w}
                        height={g.p.h}
                        rx="2"
                        class="fill-sage"
                        data-bar
                        style="transform-box: fill-box; transform-origin: center bottom;"
                      />
                      <text x={g.p.x + g.p.w / 2} y={g.base - g.p.h - 8} text-anchor="middle" font-size="12.5" font-weight="600" class="fill-sage tnum" data-bar-label>
                        {c.tirProyectoFmt[i]}
                      </text>
                      <rect
                        x={g.inv.x}
                        y={g.base - g.inv.h}
                        width={g.inv.w}
                        height={g.inv.h}
                        rx="2"
                        class="fill-copper"
                        data-bar
                        style="transform-box: fill-box; transform-origin: center bottom;"
                      />
                      <text x={g.inv.x + g.inv.w / 2} y={g.base - g.inv.h - 8} text-anchor="middle" font-size="12.5" font-weight="600" class="fill-copper tnum" data-bar-label>
                        {c.tirInversorFmt[i]}
                      </text>
                      <text x={g.p.x + g.p.w + 6} y="240" text-anchor="middle" font-size="11.5" class="fill-ink" opacity="0.6">
                        {g.esc}
                      </text>
                    </g>
                  ))}
                </svg>
                <div class="mt-4 flex gap-6 text-[0.8rem] text-ink/60">
                  <span class="flex items-center gap-2">
                    <span class="inline-block h-2.5 w-2.5 rounded-[2px] bg-sage" aria-hidden="true"></span> TIR proyecto
                  </span>
                  <span class="flex items-center gap-2">
                    <span class="inline-block h-2.5 w-2.5 rounded-[2px] bg-copper" aria-hidden="true"></span> TIR inversor (tras cascada)
                  </span>
                </div>
              </figure>

              <!-- Tabla de renta -->
              <div class="col-span-12 rounded-2xl border border-ink/10 bg-paper p-8 md:p-10 lg:col-span-6">
                <p class="eyebrow text-ink/45">Renta temporal · 3 escenarios</p>
                <table class="tnum mt-6 w-full text-left text-[0.95rem]">
                  <caption class="sr-only">
                    Renta neta anual, rentabilidad sobre inversión y cobertura de la renta preferente en tres escenarios.
                  </caption>
                  <thead>
                    <tr class="eyebrow border-b border-ink/15 text-ink/45">
                      <th scope="col" class="pb-3 font-semibold">Escenario</th>
                      <th scope="col" class="pb-3 text-right font-semibold">Renta neta/año</th>
                      <th scope="col" class="pb-3 text-right font-semibold">Yield</th>
                      <th scope="col" class="pb-3 text-right font-semibold">Cobertura pref.</th>
                    </tr>
                  </thead>
                  <tbody>
                    {c.renta.map((r) => (
                      <tr class="row-lift border-b border-ink/8">
                        <th scope="row" class="py-3.5 font-medium">{r.esc}</th>
                        <td class="py-3.5 text-right">US$ {r.neta}</td>
                        <td class="py-3.5 text-right">{r.yield}</td>
                        <td class="py-3.5 text-right" class:list={[r.cob.startsWith('0') ? 'text-copper-deep' : 'text-sage']}>
                          {r.cob}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="mt-5 text-[0.8rem] leading-relaxed text-ink/50">
                  ADR US$ 60–80 y ocupación 50–65% según escenario; costes operativos del
                  38% ya descontados. Mercado: ADR US$ 71, ocupación 47–53% (AirROI);
                  producto percentil 75+.
                </p>
              </div>
            </div>

            {c.tickets && (
              <div class="mt-6 rounded-2xl border border-copper/30 bg-paper p-8 md:p-10">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <p class="eyebrow text-copper">Tickets por co-inversor</p>
                  <p class="text-[0.85rem] text-ink/50">Según número de co-inversores en el fideicomiso</p>
                </div>
                <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
                  {c.tickets.map((t) => (
                    <div class="row-lift rounded-xl border border-ink/10 p-6">
                      <p class="eyebrow text-ink/45">{t.n}</p>
                      <p class="display tnum mt-2 text-[1.9rem]">{t.v}</p>
                      <p class="mt-1 text-[0.8rem] text-ink/45">por inversor</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })
    }
  </div>
</section>
