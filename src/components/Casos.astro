/**
 * Dos casos: real (Camargo, Villa Crespo) y metodológico (Recoleta).
 * Todos los gráficos son SVG inline hechos a mano — sin librerías de charts.
 * Los importes están escritos como literales para garantizar formato es-ES exacto.
 */

type Segmento = { label: string; val: number; fmt: string };

const casos = [
  {
    id: 'camargo',
    tab: 'Caso real · Villa Crespo',
    badge: 'Oportunidad real · Jul 2026',
    titulo: 'Camargo al 1000, Villa Crespo',
    intro:
      '3 ambientes a 3 cuadras de Palermo Soho, publicado un 35–45% bajo la media de Villa Crespo (US$ 2.085–2.482/m²).',
    plan: 'Plan: reforma de US$ 36.600 (US$ 600/m²) para reconvertir a 1 dormitorio premium + home office.',
    disclaimer:
      'Aviso activo en Zonaprop al cierre del análisis. Sujeto a verificación y disponibilidad.',
    specs: [
      { k: 'Superficie', v: '61 m²' },
      { k: 'Publicado en', v: 'US$ 83.000' },
      { k: 'Precio/m²', v: 'US$ 1.361' },
      { k: 'Descuento aparente', v: '35–45%' },
    ],
    inversion: [
      { label: 'Compra', val: 83000, fmt: '83.000' },
      { label: 'Costes compra', val: 5810, fmt: '5.810' },
      { label: 'Reforma', val: 36600, fmt: '36.600' },
      { label: 'Contingencia', val: 3660, fmt: '3.660' },
      { label: 'Equipamiento', val: 8000, fmt: '8.000' },
      { label: 'Holding obra', val: 2240, fmt: '2.240' },
    ] as Segmento[],
    total: 139310,
    totalFmt: '139.310',
    allin: 'All-in US$ 2.284/m²',
    valorPost: ['140.300', '149.450', '158.600'],
    tirProyecto: [5.6, 10.1, 15.0],
    tirProyectoFmt: ['5,6%', '10,1%', '15,0%'],
    tirInversor: [6.2, 8.8, 11.7],
    tirInversorFmt: ['6,2%', '8,8%', '11,7%'],
    renta: [
      { esc: 'Conservador', neta: '6.789', yield: '4,9%', cob: '0,81x' },
      { esc: 'Base', neta: '9.287', yield: '6,7%', cob: '1,11x' },
      { esc: 'Optimista', neta: '11.926', yield: '8,6%', cob: '1,43x' },
    ],
    tickets: [
      { n: '3 co-inversores', v: 'US$ 46.400' },
      { n: '4 co-inversores', v: 'US$ 34.800' },
      { n: '5 co-inversores', v: 'US$ 27.900' },
    ],
    plano: true,
  },
  {
    id: 'recoleta',
    tab: 'Caso metodológico · Recoleta',
    badge: 'Caso tipo · Metodología',
    titulo: 'Recoleta, 2 ambientes, 50 m²',
    intro:
      'El caso con el que modelamos la metodología, en una de las zonas de renta temporal más consolidadas.',
    plan: 'Plan: reforma integral de US$ 35.000 y equipamiento premium para media estancia.',
    disclaimer: 'Caso tipo con datos reales de mercado: ilustra la metodología.',
    specs: [
      { k: 'Superficie', v: '50 m²' },
      { k: 'Compra', v: 'US$ 85.000' },
      { k: 'Precio/m²', v: 'US$ 1.700' },
      { k: 'Horizonte', v: '3–5 años' },
    ],
    inversion: [
      { label: 'Compra', val: 85000, fmt: '85.000' },
      { label: 'Costes compra', val: 5950, fmt: '5.950' },
      { label: 'Reforma', val: 35000, fmt: '35.000' },
      { label: 'Contingencia', val: 3500, fmt: '3.500' },
      { label: 'Equipamiento', val: 7000, fmt: '7.000' },
      { label: 'Holding obra', val: 2400, fmt: '2.400' },
    ] as Segmento[],
    total: 138850,
    totalFmt: '138.850',
    allin: 'All-in US$ 2.777/m²',
    valorPost: ['147.500', '155.000', '165.000'],
    tirProyecto: [5.8, 10.5, 15.3],
    tirProyectoFmt: ['5,8%', '10,5%', '15,3%'],
    tirInversor: [6.4, 9.1, 12.1],
    tirInversorFmt: ['6,4%', '9,1%', '12,1%'],
