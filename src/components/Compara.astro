---
const filas = [
  {
    veh: 'Urbanitae',
    ret: 'TIR media realizada 12,2%',
    div: 'EUR',
    nota: 'Crowdfunding regulado (CNMV)',
  },
  {
    veh: 'StockCrowd IN',
    ret: '10–12%',
    div: 'EUR',
    nota: 'Crowdfunding regulado',
  },
  {
    veh: 'Civislend',
    ret: '8–13%',
    div: 'EUR',
    nota: 'Crowdlending inmobiliario',
  },
  {
    veh: 'Reental',
    ret: '~7–19%',
    div: 'EUR',
    nota: 'Inmobiliario tokenizado',
  },
  {
    veh: 'Depósitos / letras',
    ret: '2–3%',
    div: 'EUR',
    nota: 'Renta fija conservadora',
  },
  {
    veh: 'recoBA',
    ret: '9–12% objetivo',
    div: 'USD',
    nota: 'Activo real escriturado vía fideicomiso · equity creada en la compra',
    destacada: true,
  },
];
---

<section id="compara" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 lg:col-span-5">
        <p class="eyebrow text-copper" data-reveal>La referencia honesta</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
          Cómo compara
        </h2>
        <p class="mt-6 max-w-[28rem] text-lg text-ink/70" data-reveal>
          Frente al crowdfunding inmobiliario que ya conoces.
        </p>

        <aside class="mt-8 rounded-2xl border border-copper/30 bg-paper-2 p-6" data-reveal>
          <p class="text-[0.95rem] leading-relaxed">
            <strong>No somos una plataforma regulada por la CNMV:</strong> somos un
            operador boutique con alineación total.
          </p>
        </aside>
      </div>

      <div class="col-span-12 mt-10 lg:col-span-7 lg:mt-0">
        <table class="w-full text-left text-[0.95rem]" data-reveal>
          <caption class="sr-only">
            Comparativa de retornos entre plataformas de inversión inmobiliaria y recoBA.
          </caption>
          <thead>
            <tr class="eyebrow border-b border-ink/20 text-ink/45">
              <th scope="col" class="pb-4 font-semibold">Vehículo</th>
              <th scope="col" class="pb-4 font-semibold">Retorno</th>
              <th scope="col" class="pb-4 font-semibold">Divisa</th>
              <th scope="col" class="hidden pb-4 font-semibold sm:table-cell">Naturaleza</th>
            </tr>
          </thead>
          <tbody>
            {
              filas.map((f) => (
                <tr
                  class="row-lift border-b border-ink/8"
                  class:list={[f.destacada && 'bg-copper/8']}
                >
                  <th scope="row" class="py-4 pr-4 font-semibold" class:list={[f.destacada && 'text-copper-deep']}>
                    {f.veh}
                  </th>
                  <td class="tnum py-4 pr-4 font-medium">{f.ret}</td>
                  <td class="py-4 pr-4">
                    <span
                      class="tnum rounded-full border px-2.5 py-1 text-[0.75rem] font-semibold"
                      class:list={[f.div === 'USD' ? 'border-copper/40 text-copper-deep' : 'border-ink/15 text-ink/55']}
                    >
                      {f.div}
                    </span>
                  </td>
                  <td class="hidden py-4 text-[0.85rem] text-ink/55 sm:table-cell">{f.nota}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-4 text-[0.78rem] text-ink/45" data-reveal>
          Rangos publicados por cada plataforma; Urbanitae, TIR media realizada (CNMV).
          Rentabilidades pasadas no garantizan rentabilidades futuras.
        </p>
      </div>
    </div>
  </div>
</section>
