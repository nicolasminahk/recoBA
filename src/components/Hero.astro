---
import Shot from './Shot.astro';
import { MAILTO_DEMO, DEMO_PORTAL } from '../data/site.js';
import adminObras from '../assets/shots/admin-obras.png';
---

<section id="top" class="relative overflow-hidden pt-[6.5rem] pb-10 md:pt-[8rem] md:pb-16">
  <div class="pointer-events-none absolute inset-0 techgrid opacity-70" aria-hidden="true"></div>
  <div class="blob top-[-10%] right-[-5%] h-[30rem] w-[30rem] bg-copper/12" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="mx-auto max-w-[60rem] text-center">
      <p class="eyebrow a-fade text-copper" data-hero-eyebrow>
        Panel de seguimiento de obra e inversión
      </p>

      <h1 class="display mt-5 text-[clamp(2rem,5.4vw,4.9rem)]" data-hero-title>
        <span class="a-line"><span>Cada obra, cada euro</span></span>
        <span class="a-line"><span>y cada inversor,</span></span>
        <span class="a-line"><span><em class="not-italic text-copper">en un solo panel.</em></span></span>
      </h1>

      <p class="a-fade mx-auto mt-6 max-w-[38rem] text-lg leading-relaxed text-ink/75" data-hero-sub>
        Centraliza el seguimiento de obra, los contratos, los gastos y la inversión.
        Se instala en las cuentas de su empresa y es suyo.
      </p>

      <div class="a-fade mt-8 flex flex-wrap items-center justify-center gap-4" data-hero-ctas>
        <a href={MAILTO_DEMO} class="btn btn-copper" data-magnetic>
          Pedir una demo <span class="arr" aria-hidden="true">→</span>
        </a>
        <a href={DEMO_PORTAL} target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic>
          Ver la demo del portal <span class="arr" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="a-fade mx-auto mt-12 max-w-[72rem] md:mt-16" data-hero-shot>
      <Shot
        src={adminObras}
        domain="gestion.recoba.casa/admin"
        eager
        sizes="(min-width: 1200px) 1152px, calc(100vw - 2.5rem)"
        widths={[640, 960, 1280, 1800, 2304]}
        alt="Panel de administración de recoBA: listado de obras con obras en curso, capital de inversores, pendientes de revisar, bandeja de entrada de correo y avisos que requieren atención"
      />
    </div>
  </div>
</section>
