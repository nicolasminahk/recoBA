---
/**
 * Producto interno de recoBA: herramientas que usamos para operar y que
 * abrimos a co-inversores, colaboradores y partners.
 */
const tools = [
  {
    nombre: 'Radar de oportunidades',
    texto:
      'Rastrea publicaciones bajo mercado en Valencia, Madrid y Buenos Aires y las ordena por potencial de reforma.',
    tag: 'Uso interno y partners',
    icon: 'radar',
    href: 'https://buscador.recoba.casa',
    dominio: 'buscador.recoba.casa',
  },
  {
    nombre: 'Seguimiento de tu inversión',
    texto:
      'Panel con el avance de obra, hitos, fotos y documentos de la operación — abierto en todo momento.',
    tag: 'Para co-inversores',
    icon: 'panel',
    href: 'https://gestion.recoba.casa',
    dominio: 'gestion.recoba.casa',
  },
  {
    nombre: 'Herramientas para flippers',
    texto:
      'Lo que construimos para operar mejor lo compartimos con la comunidad que hace flipping a ambos lados del Atlántico.',
    tag: 'Comunidad',
    icon: 'comunidad',
  },
];
---

<section id="herramientas" class="relative overflow-hidden bg-ink py-24 text-paper md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>
  <div class="blob top-[15%] left-[15%] h-[26rem] w-[26rem] bg-copper/20" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 lg:col-span-6">
        <p class="eyebrow text-copper" data-reveal>Producto propio</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
          Software propio,<br />no solo capital
        </h2>
      </div>
      <div class="col-span-12 mt-6 flex items-end lg:col-span-5 lg:col-start-8 lg:mt-0">
        <p class="text-lg text-paper/65" data-reveal>
          El mismo software con el que encontramos y controlamos cada operación es
          el que ponemos a disposición de quien invierte con nosotros.
        </p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        tools.map((t) => {
          const El = t.href ? 'a' : 'article';
          return (
          <El
            href={t.href}
            target={t.href ? '_blank' : undefined}
            rel={t.href ? 'noopener' : undefined}
            class:list={[
              'glass-ink group flex flex-col rounded-2xl p-8',
              t.href &&
                'transition duration-300 hover:-translate-y-1 hover:border-copper/60',
            ]}
            data-tool-card
          >
            {t.icon === 'radar' && (
              <svg class="a-draw h-12 w-12 text-copper" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="24" cy="24" r="19" stroke-opacity="0.5" />
                <circle cx="24" cy="24" r="12" stroke-opacity="0.7" />
                <circle cx="24" cy="24" r="5" />
                <line x1="24" y1="24" x2="38" y2="12" />
                <circle cx="33" cy="17" r="2.5" fill="currentColor" />
              </svg>
            )}
            {t.icon === 'panel' && (
              <svg class="a-draw h-12 w-12 text-copper" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="5" y="8" width="38" height="32" rx="2" />
                <line x1="5" y1="17" x2="43" y2="17" />
                <line x1="18" y1="17" x2="18" y2="40" stroke-opacity="0.6" />
                <polyline points="24,33 29,27 34,30 39,23" />
              </svg>
            )}
            {t.icon === 'comunidad' && (
              <svg class="a-draw h-12 w-12 text-copper" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="24" cy="24" r="18" stroke-opacity="0.55" />
                <ellipse cx="24" cy="24" rx="8" ry="18" stroke-opacity="0.55" />
                <line x1="6" y1="24" x2="42" y2="24" />
                <circle cx="14" cy="15" r="2.5" fill="currentColor" stroke="none" />
                <circle cx="33" cy="31" r="2.5" fill="currentColor" stroke="none" />
              </svg>
            )}
            <h3 class="display mt-6 text-xl">{t.nombre}</h3>
            <p class="mt-3 text-[0.92rem] leading-relaxed text-paper/65">{t.texto}</p>
            <p class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
              <span class="eyebrow rounded-full border border-paper/25 px-3 py-1.5 text-paper/60">
                {t.tag}
              </span>
              {t.dominio && (
                <span class="eyebrow flex items-center gap-1.5 text-copper">
                  {t.dominio}
                  <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </span>
              )}
            </p>
          </El>
          );
        })
      }
    </div>
  </div>
</section>
