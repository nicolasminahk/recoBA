---
/**
 * Producto interno de recoBA: herramientas que usamos para operar y que
 * abrimos a co-inversores, colaboradores y partners. Los dos productos en
 * producción se muestran embebidos en vivo dentro de un marco de navegador.
 */
const products = [
  {
    nombre: 'Radar de oportunidades',
    texto:
      'Rastrea publicaciones bajo mercado en Valencia, Madrid y Buenos Aires y las ordena por potencial de reforma.',
    tag: 'Uso interno y partners',
    icon: 'radar',
    href: 'https://buscador.recoba.casa',
    dominio: 'buscador.recoba.casa',
    nota: 'Acceso con invitación',
  },
  {
    nombre: 'Seguimiento de tu inversión',
    texto:
      'Panel con el avance de obra, hitos, fotos y documentos de la operación — abierto en todo momento.',
    tag: 'Para co-inversores',
    icon: 'panel',
    href: 'https://gestion.recoba.casa',
    dominio: 'gestion.recoba.casa',
    nota: 'Demo abierta — entrá y recorrela',
  },
];
---

<section id="herramientas" class="relative overflow-hidden bg-ink py-24 text-paper md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>
  <div class="blob top-[15%] left-[15%] h-[26rem] w-[26rem] bg-copper/20" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 lg:col-span-6">
        <p class="eyebrow text-copper" data-reveal>Producto propio</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
          Software propio,<br />no solo capital
        </h2>
      </div>
      <div class="col-span-12 mt-6 flex items-end lg:col-span-5 lg:col-start-8 lg:mt-0">
        <p class="text-lg text-paper/65" data-reveal>
          El mismo software con el que encontramos y controlamos cada operación es
          el que ponemos a disposición de quien invierte con nosotros. Esto que ves
          abajo es el producto real, en vivo.
        </p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-2">
      {
        products.map((p) => (
          <a
            href={p.href}
            target="_blank"
            rel="noopener"
            class="glass-ink group flex flex-col overflow-hidden rounded-2xl transition duration-300 hover:-translate-y-1 hover:border-copper/60"
            data-tool-card
          >
            <!-- Barra de navegador -->
            <div class="flex items-center gap-3 border-b border-paper/12 px-5 py-3">
              <span class="flex gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full border border-paper/30"></span>
                <span class="h-2.5 w-2.5 rounded-full border border-paper/30"></span>
                <span class="h-2.5 w-2.5 rounded-full border border-copper/70 bg-copper/40"></span>
              </span>
              <span class="flex-1 truncate rounded-full border border-paper/15 px-4 py-1 text-center font-mono text-[0.72rem] tracking-wide text-paper/55">
                {p.dominio}
              </span>
              <span class="eyebrow flex items-center gap-1.5 text-copper">
                <span class="live-dot" aria-hidden="true"></span>
                En vivo
              </span>
            </div>

            <!-- Preview embebida (solo vista; el click abre el sitio real) -->
            <div class="tool-embed relative aspect-[16/10] overflow-hidden bg-ink/60">
              <iframe
                data-embed-src={p.href}
                title={`Vista en vivo de ${p.nombre}`}
                loading="lazy"
                referrerpolicy="no-referrer"
                tabindex="-1"
                aria-hidden="true"
              ></iframe>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent" aria-hidden="true"></div>
              <span class="pointer-events-none absolute right-4 bottom-4 inline-flex items-center gap-2 rounded-full border border-paper/25 bg-ink/70 px-4 py-1.5 text-[0.8rem] font-semibold backdrop-blur-sm transition duration-300 group-hover:border-copper/70 group-hover:text-copper">
                Abrir {p.dominio}
                <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </div>

            <div class="flex flex-1 flex-col p-7">
              <h3 class="display text-xl">{p.nombre}</h3>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-paper/65">{p.texto}</p>
              <p class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
                <span class="eyebrow rounded-full border border-paper/25 px-3 py-1.5 text-paper/60">
                  {p.tag}
                </span>
                <span class="text-[0.8rem] text-paper/50">{p.nota}</span>
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Comunidad: banda fina -->
    <article
      class="glass-ink mt-6 flex flex-col gap-5 rounded-2xl p-7 sm:flex-row sm:items-center"
      data-tool-card
    >
      <svg class="a-draw h-11 w-11 shrink-0 text-copper" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="24" cy="24" r="18" stroke-opacity="0.55" />
        <ellipse cx="24" cy="24" rx="8" ry="18" stroke-opacity="0.55" />
        <line x1="6" y1="24" x2="42" y2="24" />
        <circle cx="14" cy="15" r="2.5" fill="currentColor" stroke="none" />
        <circle cx="33" cy="31" r="2.5" fill="currentColor" stroke="none" />
      </svg>
      <div class="flex-1">
        <h3 class="display text-xl">Herramientas para flippers</h3>
        <p class="mt-2 text-[0.92rem] leading-relaxed text-paper/65">
          Lo que construimos para operar mejor lo compartimos con la comunidad que
          hace flipping a ambos lados del Atlántico.
        </p>
      </div>
      <span class="eyebrow self-start rounded-full border border-paper/25 px-3 py-1.5 text-paper/60 sm:self-center">
        Comunidad
      </span>
    </article>
  </div>
</section>

<style>
  /* Punto "en vivo" con pulso suave */
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--color-copper);
    animation: live-pulse 2.2s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-copper) 45%, transparent); }
    50% { box-shadow: 0 0 0 6px transparent; }
  }

  /* El iframe renderiza a doble tamaño y se escala a la mitad: así el sitio
     embebido se ve en su layout de escritorio dentro del panel. Solo vista —
     la interacción la bloquea pointer-events y el click abre el sitio real. */
  .tool-embed iframe {
    width: 200%;
    height: 200%;
    transform: scale(0.5);
    transform-origin: top left;
    border: 0;
    pointer-events: none;
    display: block;
    background: var(--color-paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
  }
</style>

<script>
  // Montar los iframes recién cuando la sección se acerca al viewport para no
  // penalizar la carga inicial (loading="lazy" no alcanza en todos los motores
  // cuando el iframe está transformado).
  const embeds = document.querySelectorAll('iframe[data-embed-src]');
  if (embeds.length) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const frame = e.target as HTMLIFrameElement;
          frame.src = frame.dataset.embedSrc ?? '';
          obs.unobserve(frame);
        });
      },
      { rootMargin: '600px 0px' }
    );
    embeds.forEach((f) => io.observe(f));
  }
</script>
