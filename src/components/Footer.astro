---
import { EMAIL, DEMO_PORTAL, DEMO_ADMIN } from '../data/site.js';
---

<footer class="border-t border-ink/10 py-14">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 lg:col-span-5">
        <div class="flex items-center gap-2.5">
          <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="12" class="fill-ink"></rect>
            <path
              d="M16 48 V34 a16 16 0 0 1 32 0 V48"
              fill="none"
              stroke="#C2603D"
              stroke-width="4.5"
              stroke-linecap="round"></path>
            <line
              x1="12"
              y1="48"
              x2="52"
              y2="48"
              stroke="#F7F3EC"
              stroke-width="3.5"
              stroke-linecap="round"></line>
          </svg>
          <span class="font-display text-lg font-semibold tracking-[0.01em]"
            >reco<span class="text-copper">BA</span></span
          >
        </div>
        <p class="mt-4 text-[0.9rem] text-ink/60">
          recoBA · Software de seguimiento de obra e inversión
        </p>
        <p class="mt-6 text-[0.9rem] text-ink/70">
          Nicolás Minahk<br />
          <a href={`mailto:${EMAIL}`} class="u-copper hover:text-copper">{EMAIL}</a>
        </p>
        <p class="mt-6 text-[0.85rem] text-ink/45">© 2026 recoBA</p>
      </div>

      <div class="col-span-12 sm:col-span-6 lg:col-span-3 lg:col-start-7">
        <h2 class="eyebrow text-ink/45">Demos navegables</h2>
        <ul class="mt-4 space-y-2.5 text-[0.9rem]">
          <li>
            <a href={DEMO_PORTAL} target="_blank" rel="noopener" class="hover:text-copper"
              >Portal del inversor <span aria-hidden="true">↗</span></a
            >
          </li>
          <li>
            <a href={DEMO_ADMIN} target="_blank" rel="noopener" class="hover:text-copper"
              >Panel de administración <span aria-hidden="true">↗</span></a
            >
          </li>
        </ul>
        <p class="mt-3 text-[0.8rem] text-ink/45">Con datos de demostración.</p>
      </div>

      <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <h2 class="eyebrow text-ink/45">Secciones</h2>
        <ul class="mt-4 space-y-2.5 text-[0.9rem]">
          <li><a href="#producto" class="hover:text-copper">Producto</a></li>
          <li><a href="#como-funciona" class="hover:text-copper">Cómo funciona</a></li>
          <li><a href="#para-quien" class="hover:text-copper">Para quién</a></li>
          <li><a href="#precios" class="hover:text-copper">Precios</a></li>
          <li><a href="#preguntas" class="hover:text-copper">Preguntas frecuentes</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
