---
import { useT } from '../i18n/index.js';

const t = useT(Astro).paraQuien;
const { perfiles } = t;
---

<section id="para-quien" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-8">
      <div class="col-span-12 lg:col-span-4">
        <p class="eyebrow text-copper" data-reveal>{t.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(1.9rem,3.4vw,2.9rem)]" data-reveal>
          {t.title}
        </h2>
        <p class="mt-5 text-[1.05rem] text-ink/70" data-reveal>
          {t.lead}
        </p>
      </div>

      <div class="col-span-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:col-span-8">
        {
          perfiles.map((p) => (
            <article class="glass rounded-2xl p-7" data-card>
              <h3 class="display text-xl">{p.titulo}</h3>
              <p class="mt-2.5 text-[0.92rem] leading-relaxed text-ink/65">{p.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
