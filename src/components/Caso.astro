---
/**
 * Un solo caso real (Camargo al 1000, Villa Crespo) con el desglose de
 * inversión y el valor post-reforma. Sin cifras de retorno: el análisis
 * completo se entrega en la llamada.
 */
type Segmento = { label: string; val: number; fmt: string };

const specs = [
  { k: 'Superficie', v: '61 m²' },
  { k: 'Publicado en', v: 'US$ 83.000' },
  { k: 'Precio/m²', v: 'US$ 1.361' },
  { k: 'Descuento aparente', v: '35–45%' },
];

const inversion: Segmento[] = [
  { label: 'Compra', val: 83000, fmt: '83.000' },
  { label: 'Costes compra', val: 5810, fmt: '5.810' },
  { label: 'Reforma', val: 36600, fmt: '36.600' },
  { label: 'Contingencia', val: 3660, fmt: '3.660' },
  { label: 'Equipamiento', val: 8000, fmt: '8.000' },
  { label: 'Holding obra', val: 2240, fmt: '2.240' },
];
const total = 139310;
const totalFmt = '139.310';

const valorPost = ['140.300', '149.450', '158.600'];
const escalas = ['Conservador', 'Base', 'Optimista'];

const tickets = [
  { n: '3 co-inversores', v: 'US$ 46.400' },
  { n: '4 co-inversores', v: 'US$ 34.800' },
  { n: '5 co-inversores', v: 'US$ 27.900' },
];

// Geometría del waterfall (viewBox 720×320)
const chartH = 220;
const base = 258;
const slot = 720 / (inversion.length + 1);
const barW = 62;
let cum = 0;
const segs = inversion.map((s, i) => {
  cum += s.val;
  const h = (s.val / total) * chartH;
  const yTop = base - (cum / total) * chartH;
  return { ...s, x: slot * i + (slot - barW) / 2, y: yTop, h, cx: slot * i + slot / 2 };
});
const totalX = slot * inversion.length + (slot - barW) / 2;
const totalY = base - chartH;

const mailto =
  'mailto:nicolasminahk@gmail.com?subject=Quiero%20el%20an%C3%A1lisis%20completo%20de%20Camargo';
---

<section id="caso" class="relative bg-paper-2 py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 techgrid opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-copper" data-reveal>La operación</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
        Un caso real,<br />con los números abiertos
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-12 gap-6">
      <!-- Ficha -->
      <div class="col-span-12 rounded-2xl border border-ink/10 bg-paper p-8 md:p-10 lg:col-span-7" data-reveal>
        <span class="eyebrow inline-block rounded-full bg-copper px-3.5 py-1.5 text-paper">
          Oportunidad real · Jul 2026
        </span>
        <h3 class="display mt-5 text-[clamp(1.8rem,3vw,2.6rem)]">Camargo al 1000, Villa Crespo</h3>
        <p class="mt-4 leading-relaxed text-ink/75">
          3 ambientes a 3 cuadras de Palermo Soho, publicado un 35–45% bajo la media
          de Villa Crespo (US$ 2.085–2.482/m²). Reforma de US$ 36.600 para
          reconvertir a 1 dormitorio premium + home office.
        </p>
        <p class="mt-5 text-[0.8rem] text-ink/45">
          Aviso activo en Zonaprop al cierre del análisis. Sujeto a verificación y disponibilidad.
        </p>
        <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-ink/10 pt-6 sm:grid-cols-4">
          {
            specs.map((s) => (
              <div class="flex flex-col-reverse justify-end">
                <dt class="eyebrow mt-1.5 text-ink/45">{s.k}</dt>
                <dd class="display tnum text-xl">{s.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Plano + valor de salida -->
      <div class="col-span-12 flex flex-col gap-6 lg:col-span-5">
        <figure class="flex-1 rounded-2xl border border-ink/10 bg-paper p-8" data-reveal>
          <figcaption class="eyebrow text-ink/45">Plano objetivo · 1 dormitorio + home office</figcaption>
          <svg
            class="a-draw mt-4 h-auto w-full max-w-[24rem] text-ink"
            viewBox="0 0 400 260"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            role="img"
            aria-label="Plano de planta esquemático: estar-comedor integrado con cocina, dormitorio y home office."
          >
            <rect x="10" y="10" width="380" height="240" />
            <line x1="180" y1="10" x2="180" y2="150" />
            <line x1="180" y1="150" x2="10" y2="150" />
            <line x1="180" y1="90" x2="280" y2="90" stroke-opacity="0.5" />
            <line x1="280" y1="10" x2="280" y2="90" />
            <path d="M180 110 a20 20 0 0 1 20 20" class="stroke-copper" stroke-width="1.2" />
            <line x1="180" y1="110" x2="180" y2="130" class="stroke-copper" stroke-width="1.2" />
            <path d="M90 150 a22 22 0 0 1 22 22" class="stroke-copper" stroke-width="1.2" />
            <rect x="300" y="30" width="70" height="12" stroke-opacity="0.6" />
            <rect x="40" y="40" width="90" height="50" stroke-opacity="0.6" />
            <rect x="40" y="180" width="120" height="50" stroke-opacity="0.6" />
            <text x="55" y="130" font-size="11" fill="currentColor" stroke="none" opacity="0.6">DORMITORIO</text>
            <text x="210" y="55" font-size="11" fill="currentColor" stroke="none" opacity="0.6">HOME OFFICE</text>
            <text x="215" y="200" font-size="11" fill="currentColor" stroke="none" opacity="0.6">ESTAR · COMEDOR</text>
            <text x="300" y="120" font-size="11" fill="currentColor" stroke="none" opacity="0.6">COCINA</text>
          </svg>
        </figure>

        <div class="rounded-2xl bg-ink p-8 text-paper" data-reveal>
          <p class="eyebrow text-paper/50">Valor de venta post-reforma</p>
          <div class="mt-4 flex flex-wrap items-end gap-x-7 gap-y-3">
            {
              valorPost.map((v, i) => (
                <div class="flex flex-col-reverse justify-end">
                  <p class="eyebrow mt-1.5 text-paper/45">{escalas[i]}</p>
                  <p class="display tnum text-[1.7rem] leading-none" class:list={[i === 1 && 'text-copper']}>
                    US$ {v}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Waterfall -->
    <figure
      class="mt-6 rounded-2xl border border-ink/10 bg-paper p-8 md:p-10"
      data-chart-waterfall
      aria-label={`Desglose de la inversión total de ${totalFmt} dólares: compra 83.000, costes de compra 5.810, reforma 36.600, contingencia 3.660, equipamiento 8.000 y holding de obra 2.240.`}
    >
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <figcaption class="eyebrow text-ink/45">Desglose de la inversión · US$</figcaption>
        <p class="display tnum text-xl">
          Total US$ {totalFmt}
          <span class="ml-2 text-[0.8rem] font-normal text-ink/45">All-in US$ 2.284/m²</span>
        </p>
      </div>
      <div class="overflow-x-auto">
        <svg
          viewBox="0 0 720 320"
          class="mx-auto mt-6 block h-auto w-full max-w-[52rem] min-w-[640px]"
          role="presentation"
        >
          <line x1="0" y1="258" x2="720" y2="258" stroke="#16181D" stroke-opacity="0.15" />
          {
            segs.map((s, i) => (
              <g>
                <rect
                  x={s.x}
                  y={s.y}
                  width={barW}
                  height={s.h}
                  rx="2"
                  class={i === 0 ? 'fill-sage' : 'fill-stone'}
                  opacity={i === 0 ? '0.9' : '0.8'}
                  data-wf-seg
                  style="transform-box: fill-box; transform-origin: center bottom;"
                />
                {i < segs.length - 1 && (
                  <line
                    x1={s.x + barW}
                    y1={s.y}
                    x2={segs[i + 1].x}
                    y2={s.y}
                    stroke="#16181D"
                    stroke-opacity="0.25"
                    stroke-dasharray="3 3"
                    data-wf-conn
                  />
                )}
                <text x={s.cx} y={s.y - 8} text-anchor="middle" font-size="13" font-weight="600" class="fill-ink tnum" data-wf-label>
                  {s.fmt}
                </text>
                <text x={s.cx} y="280" text-anchor="middle" font-size="11" class="fill-ink" opacity="0.55">
                  {s.label}
                </text>
              </g>
            ))
          }
          <g>
            <line
              x1={segs[5].x + barW}
              y1={totalY}
              x2={totalX}
              y2={totalY}
              stroke="#16181D"
              stroke-opacity="0.25"
              stroke-dasharray="3 3"
              data-wf-conn
            />
            <rect
              x={totalX}
              y={totalY}
              width={barW}
              height={chartH}
              rx="2"
              class="fill-copper"
              data-wf-seg
              style="transform-box: fill-box; transform-origin: center bottom;"
            />
            <text x={totalX + barW / 2} y={totalY - 8} text-anchor="middle" font-size="13" font-weight="600" class="fill-copper tnum" data-wf-label>
              {totalFmt}
            </text>
            <text x={totalX + barW / 2} y="280" text-anchor="middle" font-size="11" class="fill-ink" opacity="0.55">
              Total
            </text>
          </g>
        </svg>
      </div>
      <p class="mt-5 max-w-[52rem] text-[0.8rem] leading-relaxed text-ink/50">
        Desglose de la operación tal como fue analizada. En la modalidad exprés el
        equipamiento se ajusta al producto de venta y el holding se reduce por el
        plazo más corto: el número final de cada operación se presenta cerrado en la
        llamada, con sus tres escenarios.
      </p>
    </figure>

    <!-- Tickets + CTA -->
    <div class="mt-6 rounded-2xl border border-copper/30 bg-paper p-8 md:p-10" data-reveal>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <p class="eyebrow text-copper">Tickets por co-inversor</p>
        <p class="text-[0.85rem] text-ink/50">Según número de co-inversores en el fideicomiso</p>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          tickets.map((t) => (
            <div class="row-lift rounded-xl border border-ink/10 p-6">
              <p class="eyebrow text-ink/45">{t.n}</p>
              <p class="display tnum mt-2 text-[1.9rem]">{t.v}</p>
              <p class="mt-1 text-[0.8rem] text-ink/45">por inversor</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 border-t border-ink/10 pt-7">
        <a href={mailto} class="btn btn-copper" data-magnetic>
          Pedir el análisis completo <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
