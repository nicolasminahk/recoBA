---
import { useT } from '../i18n/index.js';

const t = useT(Astro).comoFunciona;
const { pasos } = t;
---

<section id="como-funciona" class="relative overflow-hidden bg-paper-2 py-20 md:py-28">
  <div class="pointer-events-none absolute inset-0 techgrid opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-6">
      <div class="col-span-12 lg:col-span-6">
        <p class="eyebrow text-copper" data-reveal>{t.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2rem,4.2vw,3.6rem)]" data-reveal>
          {t.title}
        </h2>
      </div>
      <div class="col-span-12 flex items-end lg:col-span-5 lg:col-start-8">
        <p class="text-lg text-ink/70" data-reveal>
          {t.lead}
        </p>
      </div>
    </div>

    <ol class="steps mt-14">
      {
        pasos.map((p, i) => (
          <li class="step" data-card>
            <div class="step-num display" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </div>
            <div class="step-body">
              <p class="eyebrow text-copper">{p.plazo}</p>
              <h3 class="display mt-2 text-xl">{p.titulo}</h3>
              <p class="mt-2.5 text-[0.92rem] leading-relaxed text-ink/65">{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    counter-reset: paso;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }
  .step-num {
    font-size: 1.9rem;
    line-height: 1;
    color: var(--color-copper);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 2rem;
    }
  }
  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 0 1.5rem;
    }
    .step {
      grid-template-columns: 1fr;
      padding-top: 1.75rem;
    }
    .step-num {
      font-size: 2.4rem;
      margin-bottom: 1.25rem;
    }
  }
</style>
