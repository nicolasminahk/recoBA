---
const fases = [
  {
    fase: 'Fase 1 · 2026',
    titulo: 'Operación piloto',
    texto: 'Círculo cercano y toda la documentación como precedente.',
    activa: true,
  },
  {
    fase: 'Fase 2 · 2027',
    titulo: 'Escalado',
    texto: '3–5 operaciones en paralelo y track record público.',
    activa: false,
  },
  {
    fase: 'Fase 3 · 2028+',
    titulo: 'Vehículo multi-activo',
    texto: 'Diversificación y captación estructurada desde Madrid.',
    activa: false,
  },
];

const mailto =
  'mailto:nicolasminahk@gmail.com?subject=Quiero%20saber%20m%C3%A1s%20sobre%20recoBA';
---

<section id="hoja-de-ruta" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-copper" data-reveal>Hoja de ruta</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,4.5vw,3.8rem)]" data-reveal>
        Empezamos pequeño,<br />a propósito
      </h2>
    </div>

    <ol class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        fases.map((f) => (
          <li
            class="row-lift rounded-2xl border p-8"
            class:list={[f.activa ? 'border-copper/50 bg-paper-2' : 'border-ink/10']}
            data-reveal
          >
            <p class="eyebrow" class:list={[f.activa ? 'text-copper' : 'text-ink/45']}>
              {f.fase}
              {f.activa && (
                <span class="ml-2 inline-block rounded-full bg-copper px-2 py-0.5 text-[0.6rem] text-paper">
                  Ahora
                </span>
              )}
            </p>
            <h3 class="display mt-3 text-2xl">{f.titulo}</h3>
            <p class="mt-3 text-[0.92rem] leading-relaxed text-ink/65">{f.texto}</p>
          </li>
        ))
      }
    </ol>

    <!-- CTA final -->
    <div
      class="relative mt-20 overflow-hidden rounded-3xl bg-ink px-8 py-16 text-center text-paper md:py-24"
      data-reveal
    >
      <div class="pointer-events-none absolute inset-0 techgrid-dark" aria-hidden="true"></div>
      <svg
        class="a-draw mx-auto h-14 w-14 text-copper"
        viewBox="0 0 64 64"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M16 52 V34 a16 16 0 0 1 32 0 V52" />
        <line x1="10" y1="52" x2="54" y2="52" />
      </svg>
      <h2 class="display relative mx-auto mt-6 max-w-[34rem] text-[clamp(2.2rem,5vw,4rem)]">
        ¿Hablamos?
      </h2>
      <p class="relative mx-auto mt-5 max-w-[30rem] text-lg text-paper/70">
        Treinta minutos para contarte la operación piloto — con los números delante y
        todas las preguntas incómodas que quieras.
      </p>
      <div class="relative mt-9">
        <a href={mailto} class="btn btn-copper !px-8 !py-4 text-base" data-magnetic>
          Agenda una llamada <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="relative mt-5 text-[0.85rem] text-paper/45">nicolasminahk@gmail.com</p>
    </div>
  </div>
</section>
