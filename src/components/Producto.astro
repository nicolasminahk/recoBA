---
/**
 * El producto en bloques: texto + captura real, alternando lado.
 * Cada bloque es un ancla propia dentro de #producto.
 */
import Shot from './Shot.astro';
import { Picture } from 'astro:assets';
import { useT } from '../i18n/index.js';

import bandeja from '../assets/shots/admin-obra-bandeja.png';
import diario from '../assets/shots/admin-obra-diario.png';
import movil from '../assets/shots/admin-movil-telefono.png';
import documentos from '../assets/shots/admin-obra-documentos.png';
import numeros from '../assets/shots/admin-obra-numeros.png';
import dashboard from '../assets/shots/portal-dashboard.png';
import oportunidades from '../assets/shots/portal-oportunidades.png';
import avances from '../assets/shots/portal-avances.png';
import gastos from '../assets/shots/portal-gastos.png';
import inversion from '../assets/shots/portal-inversion.png';
import camara from '../assets/shots/portal-camara.png';

const t = useT(Astro).producto;
const demoCaption = useT(Astro).common.demoCaption;

const portalTabs = [
  { src: avances, alt: t.portal.tabs.avances },
  { src: gastos, alt: t.portal.tabs.gastos },
  { src: inversion, alt: t.portal.tabs.inversion },
  { src: oportunidades, alt: t.portal.tabs.oportunidades },
];
---

<section id="producto" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-[88rem] px-5 md:px-10">
    <div class="max-w-[40rem]">
      <p class="eyebrow text-copper" data-reveal>{t.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2rem,4.2vw,3.6rem)]" data-reveal>
        {t.title}
      </h2>
      <p class="mt-5 text-lg text-ink/70" data-reveal>
        {t.lead}
      </p>
    </div>

    <!-- 1. Sus obras -->
    <article id="sus-obras" class="prod-block mt-16 md:mt-24">
      <div class="prod-text">
        <p class="eyebrow text-ink/45">{t.obras.eyebrow}</p>
        <h3 class="display mt-3 text-[clamp(1.6rem,2.8vw,2.4rem)]">
          {t.obras.title}
        </h3>
        <ul class="prod-list">
          {t.obras.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="prod-media">
        <Shot
          src={bandeja}
          domain="gestion.recoba.casa/admin"
          alt={t.obras.alt}
        />
      </div>
    </article>

    <!-- 2. Seguimiento de obra -->
    <article id="seguimiento" class="prod-block prod-block--flip mt-16 md:mt-24">
      <div class="prod-text">
        <p class="eyebrow text-ink/45">{t.seguimiento.eyebrow}</p>
        <h3 class="display mt-3 text-[clamp(1.6rem,2.8vw,2.4rem)]">
          {t.seguimiento.title}
        </h3>
        <ul class="prod-list">
          {t.seguimiento.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="prod-media">
        <div class="relative">
          <Shot
            src={diario}
            domain="gestion.recoba.casa/admin"
            alt={t.seguimiento.alt}
          />
          <figure class="prod-phone" aria-label={t.seguimiento.phoneAria}>
            <Picture
              src={movil}
              alt={t.seguimiento.phoneAlt}
              widths={[200, 320, 400]}
              sizes="160px"
              formats={['avif']}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </figure>
        </div>
      </div>
    </article>

    <!-- 3. Documentos y números -->
    <article id="documentos-numeros" class="prod-block mt-16 md:mt-24">
      <div class="prod-text">
        <p class="eyebrow text-ink/45">{t.documentos.eyebrow}</p>
        <h3 class="display mt-3 text-[clamp(1.6rem,2.8vw,2.4rem)]">
          {t.documentos.title}
        </h3>
        <ul class="prod-list">
          {t.documentos.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="prod-media">
        <div class="grid grid-cols-1 gap-5">
          <Shot
            src={documentos}
            domain="gestion.recoba.casa/admin"
            caption={false}
            alt={t.documentos.altDocs}
          />
          <Shot
            src={numeros}
            domain="gestion.recoba.casa/admin"
            alt={t.documentos.altNumeros}
          />
        </div>
      </div>
    </article>

    <!-- 4. Portal del inversor -->
    <article id="portal" class="prod-block prod-block--flip mt-16 md:mt-24">
      <div class="prod-text">
        <p class="eyebrow text-ink/45">{t.portal.eyebrow}</p>
        <h3 class="display mt-3 text-[clamp(1.6rem,2.8vw,2.4rem)]">
          {t.portal.title}
        </h3>
        <ul class="prod-list">
          {t.portal.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="prod-media">
        <Shot
          src={dashboard}
          domain="gestion.recoba.casa"
          caption={false}
          alt={t.portal.alt}
        />
        <ul class="mt-4 grid grid-cols-4 gap-3" aria-label={t.portal.tabsAria}>
          {
            portalTabs.map((t) => (
              <li class="overflow-hidden rounded-lg border border-ink/12 bg-white">
                <Picture
                  src={t.src}
                  alt={t.alt}
                  widths={[240, 400]}
                  sizes="(min-width: 1024px) 11vw, 22vw"
                  formats={['avif']}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </li>
            ))
          }
        </ul>
        <p class="mt-2.5 text-[0.74rem] tracking-wide text-ink/45">{demoCaption}</p>
      </div>
    </article>

    <!-- 5. Cámaras de obra -->
    <article id="camaras" class="prod-block mt-16 md:mt-24">
      <div class="prod-text">
        <p class="eyebrow text-ink/45">{t.camaras.eyebrow}</p>
        <h3 class="display mt-3 text-[clamp(1.6rem,2.8vw,2.4rem)]">
          {t.camaras.title}
        </h3>
        <ul class="prod-list">
          {t.camaras.items.map((i) => <li>{i}</li>)}
        </ul>
        <dl class="mt-7 grid grid-cols-1 gap-5 border-t border-ink/12 pt-6 sm:grid-cols-2">
          <div>
            <dt class="eyebrow text-ink/45">{t.camaras.empresaLabel}</dt>
            <dd class="mt-2 text-[0.92rem] leading-relaxed text-ink/70">
              {t.camaras.empresa}
            </dd>
          </div>
          <div>
            <dt class="eyebrow text-copper">{t.camaras.recobaLabel}</dt>
            <dd class="mt-2 text-[0.92rem] leading-relaxed text-ink/70">
              {t.camaras.recoba}
            </dd>
          </div>
        </dl>
        <p class="mt-5 text-[0.82rem] leading-relaxed text-ink/50">
          {t.camaras.nota}
        </p>
      </div>
      <div class="prod-media">
        <Shot
          src={camara}
          domain="gestion.recoba.casa"
          alt={t.camaras.alt}
        />
      </div>
    </article>
  </div>
</section>

<style>
  .prod-block {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    align-items: center;
  }
  .prod-text {
    grid-column: span 12;
  }
  .prod-media {
    grid-column: span 12;
  }
  @media (min-width: 1024px) {
    .prod-text {
      grid-column: 1 / span 5;
    }
    .prod-media {
      grid-column: 7 / span 6;
    }
    .prod-block--flip .prod-text {
      grid-column: 8 / span 5;
      order: 2;
    }
    .prod-block--flip .prod-media {
      grid-column: 1 / span 6;
      order: 1;
    }
  }
  .prod-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .prod-list li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  .prod-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-copper);
  }
  /* Móvil superpuesto a la captura de escritorio (solo en pantallas anchas) */
  .prod-phone {
    display: none;
  }
  @media (min-width: 640px) {
    .prod-phone {
      display: block;
      position: absolute;
      right: -0.75rem;
      bottom: 1.5rem;
      width: 9.5rem;
      overflow: hidden;
      border-radius: 1.1rem;
      border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
      background: #fff;
      box-shadow: 0 24px 50px -20px color-mix(in srgb, var(--color-ink) 45%, transparent);
    }
  }
  @media (min-width: 1280px) {
    .prod-phone {
      width: 11rem;
      right: -1.5rem;
    }
  }
</style>
